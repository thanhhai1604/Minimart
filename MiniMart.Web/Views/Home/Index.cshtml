        });

        const topCustomer = data[0];

        // Tạm tính doanh thu trước thuế và thuế với thuế suất minh họa 8%.
        const beforeTax = topCustomer.revenue / 1.08;
        const tax = topCustomer.revenue - beforeTax;

        document.getElementById('customerBeforeTax').textContent =
            formatMoney(beforeTax);

        document.getElementById('customerTax').textContent =
            formatMoney(tax);

    }


