        document.getElementById('revenueBeforeTax').textContent =
            formatMoney(data.beforeTax);

        document.getElementById('revenueTax').textContent =
            formatMoney(data.tax);

        revenueChart.data.labels = data.labels;

        revenueChart.data.datasets[0].data = data.values;

        revenueChart.update();

    }


