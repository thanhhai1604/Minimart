        tbody.innerHTML = '';

        data.forEach((item, index) => {

            tbody.innerHTML += `
                <tr>
                    <td>
                        <span class="rank-badge ${getRankClass(index)}">
                            ${index + 1}
                        </span>
                    </td>

                    <td class="fw-semibold">
                        ${item.name}
                    </td>

                    <td class="money">
                        ${formatMoney(item.revenue)}
                    </td>
                </tr>
            `;

        });

        const topStore = data[0];

        document.getElementById('storeBeforeTax').textContent =
            formatMoney(topStore.beforeTax);

        document.getElementById('storeTax').textContent =
            formatMoney(topStore.tax);

    }


