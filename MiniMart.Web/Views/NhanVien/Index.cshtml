@model IEnumerable<MiniMart.Web.Models.NhanVien>
@using MiniMart.Web.Helpers

@{
    ViewData["Title"] = "Danh sách nhân viên";
    string? maSTCuaToi = ViewBag.MaSTCuaToi as string;
    string? tenSTCuaToi = ViewBag.TenSTCuaToi as string;
}

<!-- Nhúng thư viện Select2 CSS & DataTables Bootstrap 5 -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/datatables.net-bs5@1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet" />

<style>
    #nhanVienTable tbody tr {
        cursor: pointer;
    }
    #nhanVienTable thead .filter-row th {
        cursor: default;
    }
    #nhanVienTable thead .filter-row th::before,
    #nhanVienTable thead .filter-row th::after {
        display: none !important;
    }
</style>

<div class="container-fluid px-4 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="fw-bold mb-0 text-success" style="color: #198754 !important;">
                <i class="bi bi-people-fill me-2"></i> Danh Sách Nhân Viên
            </h3>
            <p class="text-success fw-bold small mb-0">
                Quản lý thông tin hồ sơ nhân sự hệ thống
            </p>
        </div>
        <div class="d-flex gap-2">
            <button id="btnXoaBoLoc" class="btn btn-outline-secondary fw-semibold shadow-sm">
                <i class="bi bi-arrow-counterclockwise me-1"></i> Xóa bộ lọc
            </button>
            
            @if (Html.HasPermission("WEB_QL_NV_THEM"))
            {
                <a asp-action="Create" class="btn btn-success fw-bold shadow-sm">
                    <i class="bi bi-plus-lg me-1"></i> Thêm nhân viên
                </a>
            }
        </div>
    </div>
    <hr />

    <div class="card border-0 shadow-sm rounded-3 overflow-hidden mb-5">
        <div class="card-body p-3">
            <div class="table-responsive">
                <table id="nhanVienTable" class="table table-hover table-bordered align-middle w-100">
                    <thead class="table-light text-secondary">
                        <tr>
                            <th class="text-center" style="width: 5%;">STT</th>
                            <th>Mã Nhân Viên</th>
                            <th>Tên Nhân Viên</th>
                            <th>Tên Đăng Nhập</th>
                            <th>Vai Trò</th>
                            <th>Số Điện Thoại</th>
                            <th>Siêu Thị Trực Thuộc</th>
                            <th class="text-center">Trạng Thái</th>
                        </tr>
                        <tr class="filter-row">
                            <th class="text-center"></th>
                            <th><input type="text" class="form-control form-control-sm column-search" data-col="1" placeholder="Nhập mã nhân viên..." /></th>
                            <th><input type="text" class="form-control form-control-sm column-search" data-col="2" placeholder="Nhập tên nhân viên..." /></th>
                            <th><input type="text" class="form-control form-control-sm column-search" data-col="3" placeholder="Nhập tên đăng nhập..." /></th>
                            <th>
                                <select class="form-select form-select-sm select2-filter" data-col="4" style="width: 100%;">
                                    <option value="">Tất cả vai trò</option>
                                    @if (Model != null)
                                    {
                                        @foreach (var tenVaiTro in Model.Select(x => x.VaiTro?.TenVaiTro).Distinct().Where(x => x != null))
                                        {
                                            <option value="@tenVaiTro">@tenVaiTro</option>
                                        }
                                    }
                                </select>
                            </th>
                            <th><input type="text" class="form-control form-control-sm column-search" data-col="5" placeholder="Nhập số điện thoại..." /></th>
                            <th>
                                <select class="form-select form-select-sm select2-filter" data-col="6" id="selectFilterSieuThi" style="width: 100%;">
                                    @if (string.IsNullOrEmpty(maSTCuaToi))
                                    {
                                        <option value="">Tất cả siêu thị</option>
                                    }
                                    @if (Model != null)
                                    {
                                        @foreach (var tenSieuThi in Model.Select(x => x.SieuThi?.TenST).Distinct().Where(x => x != null))
                                        {
                                            <option value="@tenSieuThi">@tenSieuThi</option>
                                        }
                                    }
                                </select>
                            </th>
                            <th class="text-center">
                                <select class="form-select form-select-sm select2-filter" data-col="7" style="width: 100%;">
                                    <option value="">Tất cả trạng thái</option>
                                    <option value="Đang làm việc">Đang làm việc</option>
                                    <option value="Ngừng làm việc">Ngừng làm việc</option>
                                </select>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            int chiSo = 1;
                            foreach (var item in Model)
                            {
                                <tr data-id="@item.MaNV">
                                    <td class="text-center fw-semibold text-muted">@chiSo</td>
                                    <td class="fw-bold text-success">@item.MaNV</td>
                                    <td class="fw-semibold text-dark">@item.HoTen</td>
                                    <td class="text-muted">@item.TenDN</td>
                                    <td><span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 fw-semibold">@(item.VaiTro != null ? item.VaiTro.TenVaiTro : "Chưa phân vai trò")</span></td>
                                    <td>@item.SoDT</td>
                                    <td><span class="text-primary fw-semibold">@(item.SieuThi != null ? item.SieuThi.TenST : (item.MaST ?? "Tất cả siêu thị"))</span></td>
                                    <td class="text-center">
                                        @if (item.TrangThai == 1)
                                        {
                                            <span class="badge bg-primary px-2 py-1">Đang làm việc</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary px-2 py-1">Ngừng làm việc</span>
                                        }
                                    </td>
                                </tr>
                                chiSo++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/datatables.net@1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/datatables.net-bs5@1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(document).ready(function () {
            var maSTCuaToi = '@maSTCuaToi';
            var tenSTCuaToi = '@tenSTCuaToi';

            var table = $('#nhanVienTable').DataTable({
                "language": { "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/vi.json" },
                "orderCellsTop": true,
                "columnDefs": [{ "orderable": false, "targets": 0 }],
                "order": [[1, 'asc']]
            });

            // KHÔNG dùng table.column(6).search(...) lúc load nữa vì Controller đã lọc sẵn dữ liệu chuẩn ở backend.
            // Chỉ cần set giá trị hiển thị trên dropdown Select2 cho đúng:
            if (maSTCuaToi && tenSTCuaToi) {
                $('#selectFilterSieuThi').val(tenSTCuaToi);
            }

            table.on('draw.dt', function () {
                var start = table.page.info().start;
                table.column(0, { search: 'applied', order: 'applied', page: 'current' })
                    .nodes().each(function (cell, i) { cell.innerHTML = start + i + 1; });
            }).draw();

            $('.select2-filter').select2({ theme: 'bootstrap-5', width: '100%', minimumResultsForSearch: 0 });

            // Gán lại giá trị cho Select2 hiển thị đúng sau khi init select2
            if (maSTCuaToi && tenSTCuaToi) {
                $('#selectFilterSieuThi').val(tenSTCuaToi).trigger('change.select2');
            }

            $('.filter-row').on('click', 'input, select, .select2, .select2-selection', function (e) {
                e.stopPropagation();
            });

            $('.column-search').on('keyup change clear', function () {
                table.column($(this).data('col')).search(this.value).draw();
            });

            $('.select2-filter').on('change', function () {
                var colIndex = $(this).data('col');
                var giaTri = $(this).val();
                
                // Nếu là tài khoản giới hạn siêu thị, không cho phép xóa chọn siêu thị trên ô lọc
                if (colIndex === 6 && maSTCuaToi && !giaTri) {
                    $('#selectFilterSieuThi').val(tenSTCuaToi).trigger('change.select2');
                    return;
                }

                if (!giaTri) {
                    table.column(colIndex).search('').draw();
                } else {
                    var regex = '^\\s*' + $.fn.dataTable.util.escapeRegex(giaTri) + '\\s*$';
                    table.column(colIndex).search(regex, true, false).draw();
                }
            });

            $('#btnXoaBoLoc').on('click', function () {
                $('.column-search').val('');
                $('.select2-filter').each(function () {
                    var colIdx = $(this).data('col');
                    if (colIdx === 6 && maSTCuaToi) {
                        $(this).val(tenSTCuaToi).trigger('change.select2');
                    } else {
                        $(this).val('').trigger('change.select2');
                    }
                });
                
                table.search('').columns().search('').draw();
                // Nếu có giới hạn siêu thị thì giữ lại điều kiện lọc siêu thị của mình
                if (maSTCuaToi && tenSTCuaToi) {
                    var regex = '^\\s*' + $.fn.dataTable.util.escapeRegex(tenSTCuaToi) + '\\s*$';
                    table.column(6).search(regex, true, false).draw();
                }
            });

            $('#nhanVienTable tbody').on('click', 'tr', function () {
                @if (Html.HasPermission("WEB_QL_NV_XEM"))
                {
                    <text>
                    var maNV = $(this).data('id');
                    if (maNV) { window.location.href = '/NhanVien/Edit/' + maNV; }
                    </text>
                }
                else
                {
                    <text>
                    var permissionModal = new bootstrap.Modal(document.getElementById('permissionErrorModal'));
                    permissionModal.show();
                    </text>
                }
            });
        });
    </script>
}