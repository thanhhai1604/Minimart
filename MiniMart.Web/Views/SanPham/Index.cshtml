@model IEnumerable<MiniMart.Web.Models.SanPham>
@using MiniMart.Web.Helpers

@{
    ViewData["Title"] = "Danh sách sản phẩm";
}

<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/datatables.net-bs5@1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet" />

<style>
    #sanPhamTable tbody tr { cursor: pointer; }
    #sanPhamTable thead .filter-row th { cursor: default; }
    #sanPhamTable thead .filter-row th::before,
    #sanPhamTable thead .filter-row th::after { display: none !important; }
</style>

<div class="container-fluid px-4 mt-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="fw-bold mb-0 text-success" style="color: #198754 !important;">
                <i class="bi bi-box-seam me-2"></i> Danh Sách Sản Phẩm
            </h3>
            <p class="text-success fw-bold small mb-0">
                Quản lý danh mục sản phẩm, mã UPC, đơn vị tính và mức thuế áp dụng trong hệ thống
            </p>
        </div>

        @if (Html.HasPermission("WEB_HH_SP_THEM"))
        {
            <a asp-action="Create" class="btn btn-success fw-bold shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Thêm sản phẩm
            </a>
        }
    </div>
    <hr />

    <div class="card border-0 shadow-sm rounded-3 overflow-hidden mb-5">
        <div class="card-body p-3">
            <div class="table-responsive">
                <table id="sanPhamTable" class="table table-hover table-bordered align-middle w-100">
                    <thead class="table-light text-secondary">
                        <tr>
                            <th class="text-center" style="width: 5%;">STT</th>
                            <th>Mã SP</th>
                            <th>Mã UPC</th>
                            <th>Tên Sản Phẩm</th>
                            <th>Đơn Vị Tính</th>
                            <th>Loại Sản Phẩm</th>
                            <th>Danh Mục</th>
                            <th>Thuế</th>
                        </tr>
                        <tr class="filter-row">
                            <th class="text-center"></th>
                            <th>
                                <input type="text" class="form-control form-control-sm column-search"
                                       data-col="1" placeholder="Nhập mã SP..." />
                            </th>
                            <th>
                                <input type="text" class="form-control form-control-sm column-search"
                                       data-col="2" placeholder="Nhập mã UPC..." />
                            </th>
                            <th>
                                <input type="text" class="form-control form-control-sm column-search"
                                       data-col="3" placeholder="Nhập tên sản phẩm..." />
                            </th>
                            <th>
                                <input type="text" class="form-control form-control-sm column-search"
                                       data-col="4" placeholder="Nhập ĐVT..." />
                            </th>
                            <th>
                                <input type="text" class="form-control form-control-sm column-search"
                                       data-col="5" placeholder="Nhập loại SP..." />
                            </th>
                            <th>
                                <select class="form-select form-select-sm select2-filter" data-col="6" style="width: 100%;">
                                    <option value="">Tất cả danh mục</option>
                                    @if (Model != null)
                                    {
                                        @foreach (var dm in Model
                                            .Select(x => x.DanhMucNavigation?.TenDanhMuc)
                                            .Where(x => !string.IsNullOrWhiteSpace(x))
                                            .Distinct()
                                            .OrderBy(x => x))
                                        {
                                            <option value="@dm">@dm</option>
                                        }
                                    }
                                </select>
                            </th>
                            <th>
                                <select class="form-select form-select-sm select2-filter" data-col="7" style="width: 100%;">
                                    <option value="">Tất cả mức thuế</option>
                                    @if (Model != null)
                                    {
                                        @foreach (var thue in Model
                                            .Select(x => x.ThueNavigation?.TenThue)
                                            .Where(x => !string.IsNullOrWhiteSpace(x))
                                            .Distinct()
                                            .OrderBy(x => x))
                                        {
                                            <option value="@thue">@thue</option>
                                        }
                                    }
                                </select>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            int chiSo = 1;
                            foreach (var item in Model)
                            {
                                var tenDanhMuc = item.DanhMucNavigation?.TenDanhMuc ?? "---";
                                var tenThue = item.ThueNavigation?.TenThue ?? "---";

                                <tr data-masp="@item.MaSP">
                                    <td class="text-center fw-semibold text-muted">@chiSo</td>
                                    <td class="fw-bold text-success">@item.MaSP</td>
                                    <td class="text-dark">@item.UPC</td>
                                    <td class="fw-semibold text-dark">@item.TenSP</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.DonViTinh) ? "---" : item.DonViTinh)</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.LoaiSP) ? "---" : item.LoaiSP)</td>
                                    <td class="text-primary fw-semibold">@tenDanhMuc</td>
                                    <td>@tenThue</td>
                                </tr>
                                chiSo++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/datatables.net@1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/datatables.net-bs5@1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(document).ready(function () {
            var table = $('#sanPhamTable').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/vi.json",
                    "searchPlaceholder": "Nhập tìm kiếm...",
                    "emptyTable": "Không có dữ liệu sản phẩm phù hợp."
                },
                "orderCellsTop": true,
                "pageLength": 10,
                "columnDefs": [
                    { "orderable": false, "targets": [0] }
                ],
                "order": [[1, 'asc']]
            });

            table.on('draw.dt', function () {
                var start = table.page.info().start;
                table.column(0, { search: 'applied', order: 'applied', page: 'current' })
                    .nodes().each(function (cell, i) {
                        cell.innerHTML = start + i + 1;
                    });
            }).draw();

            $('.select2-filter').select2({
                theme: 'bootstrap-5',
                width: '100%',
                minimumResultsForSearch: 0
            });

            $('.filter-row').on('click', 'input, select, .select2, .select2-selection', function (e) {
                e.stopPropagation();
            });

            $('.column-search').on('keyup change clear', function () {
                table.column($(this).data('col')).search(this.value).draw();
            });

            $('.select2-filter').on('change', function () {
                var colIndex = $(this).data('col');
                var giaTri = $(this).val();
                if (!giaTri) {
                    table.column(colIndex).search('').draw();
                } else {
                    var regex = '^\\s*' + $.fn.dataTable.util.escapeRegex(giaTri) + '\\s*$';
                    table.column(colIndex).search(regex, true, false).draw();
                }
            });

            $('#sanPhamTable tbody').on('click', 'tr', function () {
                var maSP = $(this).data('masp');
                if (!maSP) return;

                @if (Html.HasPermission("WEB_HH_SP_XEM"))
                {
                    <text>
                    window.location.href = '/SanPham/Edit/' + encodeURIComponent(maSP);
                    </text>
                }
                else
                {
                    <text>
                    var modalEl = document.getElementById('permissionErrorModal');
                    if (modalEl) {
                        var permissionModal = new bootstrap.Modal(modalEl);
                        permissionModal.show();
                    }
                    </text>
                }
            });

            @if (TempData["ForeignKeyDeleteError"] != null)
            {
                <text>
                var fkModalEl = document.getElementById('foreignKeyDeleteErrorModal');
                if (fkModalEl) {
                    var msgEl = document.getElementById('foreignKeyDeleteErrorMessage');
                    if (msgEl) {
                        msgEl.textContent = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["ForeignKeyDeleteError"]!.ToString()));
                    }
                    var fkModal = bootstrap.Modal.getOrCreateInstance(fkModalEl);
                    fkModal.show();
                }
                </text>
            }
        });
    </script>
}