@model MiniMart.Web.Models.PhieuNhap
@using MiniMart.Web.Helpers
@using Microsoft.AspNetCore.Mvc.Rendering
@using System.Text.Json

@{
    ViewData["Title"] = "Chi tiết phiếu nhập hàng";
    bool coCapNhat = Html.HasPermission("WEB_HH_NH_CAPNHAT");
    bool coHuy = Html.HasPermission("WEB_HH_NH_HUY");
    bool daGiaoHang = Model.TrangThai == 1;
    bool choPhepSua = coCapNhat && !daGiaoHang;
    string chiTietJson = ViewBag.ChiTietJson as string ?? "[]";
    string danhSachSanPhamJson = ViewBag.DanhSachSanPhamJson as string ?? "[]";
    var dsSieuThi = ViewBag.DanhSachSieuThi as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var dsNhaCungCap = ViewBag.DanhSachNhaCungCap as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    string trangThaiClass = Model.TrangThai == 1 ? "text-success" : "text-danger";
}

<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />

<style>
    .inline-qty-input {
        width: 90px;
        margin-left: auto;
    }

    .inline-price-input {
        width: 135px;
        margin-left: auto;
    }
</style>

<div class="container-fluid px-4 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="fw-bold mb-0 text-success" style="color: #198754 !important;">
                Chi Tiết Phiếu Nhập Hàng
            </h3>
            <p class="text-success fw-bold small mb-0">
                Xem và quản lý thông tin phiếu nhập hàng @Model.MaPN
            </p>
        </div>

        <div class="d-flex gap-2">
            @if (choPhepSua)
            {
                <button type="button" id="btnResetEdit" class="btn btn-outline-secondary fw-semibold shadow-sm">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Khôi phục ban đầu
                </button>
            }
            <a asp-action="Index" class="btn btn-outline-secondary fw-semibold shadow-sm scalable back">
                <i class="bi bi-arrow-left me-1"></i> Quay lại
            </a>
        </div>
    </div>
    <hr />

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form asp-action="Edit" asp-route-id="@Model.MaPN" method="post" id="editPhieuNhapForm">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3" role="alert"></div>

        <input type="hidden" name="MaPN" value="@Model.MaPN" />
        <input type="hidden" name="MaST" value="@Model.MaST" />
        <input type="hidden" name="MaNV" value="@Model.MaNV" />
        <input type="hidden" name="chiTietJson" id="chiTietJson" value="@chiTietJson" />

        <!-- PHẦN TRÊN: THÔNG TIN PHIẾU NHẬP HÀNG (CÓ KHOẢNG TRỐNG 2 BÊN) -->
        <div class="row justify-content-center mb-4">
            <div class="col-md-10">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body p-4">
                        <h5 class="fw-bold text-success mb-3">
                            <i class="bi bi-info-circle me-2"></i> Thông tin phiếu nhập hàng
                        </h5>

                        <!-- Dòng 1: Mã Phiếu Nhập Hàng - Ngày Nhập Hàng - Nhân Viên Lập Phiếu -->
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-semibold small text-secondary">Mã Phiếu Nhập Hàng</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-success">
                                        <i class="bi bi-code-square"></i>
                                    </span>
                                    <input type="text" class="form-control bg-light border-start-0 ps-0 fw-bold text-success" value="@Model.MaPN" disabled />
                                </div>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label for="NgayNhap" class="form-label fw-semibold small text-secondary">
                                    Ngày Nhập Hàng <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-primary">
                                        <i class="bi bi-calendar-event"></i>
                                    </span>
                                    <input type="datetime-local" name="NgayNhap"
                                           value="@Model.NgayNhap.ToString("yyyy-MM-ddTHH:mm")"
                                           class="form-control bg-light border-start-0 ps-0" id="NgayNhap" disabled="@(!choPhepSua)" />
                                </div>
                                <span class="text-danger small" data-valmsg-for="NgayNhap" data-valmsg-replace="true"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-semibold small text-secondary">Nhân Viên Lập Phiếu</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-secondary">
                                        <i class="bi bi-person-badge"></i>
                                    </span>
                                    <input type="text" class="form-control bg-light border-start-0 ps-0"
                                           value="@(Model.NhanVienNavigation?.HoTen ?? (string.IsNullOrWhiteSpace(Model.MaNV) ? "---" : Model.MaNV))" disabled />
                                </div>
                            </div>
                        </div>

                        <!-- Dòng 2: Siêu Thị Nhập Hàng - Nhà Cung Cấp - Trạng Thái -->
                        <div class="row">
                            <div class="col-md-4 mb-0">
                                <label class="form-label fw-semibold small text-secondary">Siêu Thị Nhập Hàng</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-success">
                                        <i class="bi bi-shop-window"></i>
                                    </span>
                                    <select class="form-select bg-light border-start-0" disabled>
                                        @foreach (var st in dsSieuThi)
                                        {
                                            if (st.Value == Model.MaST || st.Selected)
                                            {
                                                <option value="@st.Value" selected="selected">@st.Text</option>
                                            }
                                            else
                                            {
                                                <option value="@st.Value">@st.Text</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="col-md-4 mb-0">
                                <label for="MaNCC" class="form-label fw-semibold small text-secondary">
                                    Nhà Cung Cấp <span class="text-danger">*</span>
                                </label>
                                @if (choPhepSua)
                                {
                                    <select id="MaNCC" name="MaNCC" class="form-select bg-light select2-lookup">
                                        <option value="">-- Chọn nhà cung cấp --</option>
                                        @foreach (var ncc in dsNhaCungCap)
                                        {
                                            if (ncc.Value == Model.MaNCC || ncc.Selected)
                                            {
                                                <option value="@ncc.Value" selected="selected">@ncc.Text</option>
                                            }
                                            else
                                            {
                                                <option value="@ncc.Value">@ncc.Text</option>
                                            }
                                        }
                                    </select>
                                }
                                else
                                {
                                    <select id="MaNCC" class="form-select bg-light" disabled>
                                        <option value="">-- Chọn nhà cung cấp --</option>
                                        @foreach (var ncc in dsNhaCungCap)
                                        {
                                            if (ncc.Value == Model.MaNCC || ncc.Selected)
                                            {
                                                <option value="@ncc.Value" selected="selected">@ncc.Text</option>
                                            }
                                            else
                                            {
                                                <option value="@ncc.Value">@ncc.Text</option>
                                            }
                                        }
                                    </select>
                                    <input type="hidden" name="MaNCC" value="@Model.MaNCC" />
                                }
                                <span class="text-danger small" data-valmsg-for="MaNCC" data-valmsg-replace="true"></span>
                            </div>

                            <div class="col-md-4 mb-0">
                                <label for="TrangThai" class="form-label fw-semibold small text-secondary">
                                    Trạng Thái
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 @trangThaiClass" id="trangThaiIconBox">
                                        <i class="bi bi-toggle-on" id="trangThaiIcon"></i>
                                    </span>
                                    @if (choPhepSua)
                                    {
                                        <select id="TrangThai" name="TrangThai" class="form-select bg-light border-start-0 fw-semibold @trangThaiClass">
                                            @if (Model.TrangThai == 1)
                                            {
                                                <option value="0" class="text-danger">Chưa giao hàng</option>
                                                <option value="1" class="text-success" selected="selected">Đã giao hàng</option>
                                            }
                                            else
                                            {
                                                <option value="0" class="text-danger" selected="selected">Chưa giao hàng</option>
                                                <option value="1" class="text-success">Đã giao hàng</option>
                                            }
                                        </select>
                                    }
                                    else
                                    {
                                        <select id="TrangThai" class="form-select bg-light border-start-0 fw-semibold @trangThaiClass" disabled>
                                            @if (Model.TrangThai == 1)
                                            {
                                                <option value="0" class="text-danger">Chưa giao hàng</option>
                                                <option value="1" class="text-success" selected="selected">Đã giao hàng</option>
                                            }
                                            else
                                            {
                                                <option value="0" class="text-danger" selected="selected">Chưa giao hàng</option>
                                                <option value="1" class="text-success">Đã giao hàng</option>
                                            }
                                        </select>
                                        <input type="hidden" name="TrangThai" value="@Model.TrangThai" />
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (choPhepSua)
        {
            <!-- KHỐI THÊM SẢN PHẨM NHẬP HÀNG -->
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold text-success mb-3">
                        <i class="bi bi-cart-plus me-2"></i> Thêm Sản Phẩm Nhập Hàng
                    </h5>

                    <div class="row g-3 align-items-end bg-light p-3 rounded-3 border mb-0">
                        <div class="col-md-4">
                            <label for="addMaSP" class="form-label fw-semibold small text-secondary">Chọn sản phẩm</label>
                            <select id="addMaSP" class="form-select bg-white select2-sp" style="width: 100%;">
                                <option value="">Chọn sản phẩm nhập hàng</option>
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label for="addTenSP" class="form-label fw-semibold small text-secondary">Tên Sản Phẩm</label>
                            <input type="text" id="addTenSP" class="form-control bg-white fw-semibold" readonly placeholder="Tên sản phẩm..." />
                        </div>

                        <div class="col-md-2">
                            <label for="addSoLuong" class="form-label fw-semibold small text-secondary">Số Lượng</label>
                            <input type="number" min="1" step="1" id="addSoLuong" class="form-control bg-white text-end fw-semibold" placeholder="0" />
                        </div>

                        <div class="col-md-2">
                            <label for="addGiaNhap" class="form-label fw-semibold small text-secondary">Giá Nhập</label>
                            <input type="text" inputmode="numeric" id="addGiaNhap" class="form-control bg-white text-end fw-semibold currency-input" value="0 ₫" autocomplete="off" />
                        </div>

                        <div class="col-md-1 d-grid">
                            <button type="button" id="btnAddChiTiet" class="btn btn-success fw-bold">
                                <i class="bi bi-plus-lg"></i> Thêm
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- KHỐI TÁCH RIÊNG: DANH SÁCH SẢN PHẨM NHẬP HÀNG -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-body p-4">
                <h5 class="fw-bold text-success mb-3">
                    <i class="bi bi-cart-plus me-2"></i> Danh Sách Sản Phẩm Nhập Hàng
                </h5>

                <div class="table-responsive">
                    <table id="chiTietTable" class="table table-bordered table-hover align-middle mb-0">
                        <thead class="table-light text-secondary">
                            <tr>
                                <th class="text-center" style="width: 5%;">STT</th>
                                <th style="width: 14%;">Mã Sản Phẩm</th>
                                <th>Tên Sản Phẩm</th>
                                <th class="text-end" style="width: 12%;">Số Lượng</th>
                                <th class="text-end" style="width: 16%;">Giá Nhập</th>
                                <th class="text-end" style="width: 16%;">Thành Tiền</th>
                                @if (choPhepSua)
                                {
                                    <th class="text-center" style="width: 7%;">Xóa</th>
                                }
                            </tr>
                        </thead>
                        <tbody id="chiTietBody"></tbody>
                        <tfoot>
                            <tr class="table-light fw-bold">
                                <td colspan="5" class="text-end text-dark">Tổng cộng:</td>
                                <td class="text-end text-success fs-6" id="tongTienDisplay">0 ₫</td>
                                @if (choPhepSua)
                                {
                                    <td></td>
                                }
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <div class="d-flex justify-content-between align-items-center border-top pt-3 mt-4">
                    <div>
                        @if (coHuy && !daGiaoHang)
                        {
                            <button type="button" class="btn btn-danger text-white fw-bold shadow-sm px-3" id="btnOpenHuyModal">
                                <i class="bi bi-x-circle me-1"></i> Hủy phiếu nhập hàng
                            </button>
                        }
                    </div>

                    <div>
                        @if (choPhepSua)
                        {
                            <button type="submit" class="btn btn-success px-4 fw-bold shadow-sm">
                                <i class="bi bi-save me-1"></i> Lưu thay đổi
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@if (coHuy && !daGiaoHang)
{
    <div class="modal fade" id="huyPhieuNhapModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-3 overflow-hidden">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> Xác nhận hủy phiếu nhập hàng!
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-secondary mb-2">Bạn chắc chắn muốn hủy phiếu nhập hàng sau khỏi hệ thống?</p>
                    <div class="bg-light p-3 rounded-3 border small">
                        <div class="mb-1">Mã phiếu nhập: <span class="fw-bold text-dark">@Model.MaPN</span></div>
                        <div>Nhà cung cấp: <span class="fw-bold text-dark">@(Model.NhaCungCapNavigation?.TenNCC ?? Model.MaNCC)</span></div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0">
                    <button type="button" class="btn btn-secondary px-3 fw-bold" data-bs-dismiss="modal">Hủy bỏ</button>
                    <form asp-action="Delete" asp-route-id="@Model.MaPN" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger text-white px-4 fw-bold shadow-sm">
                            <i class="bi bi-trash me-1"></i> Xác nhận hủy
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(document).ready(function () {
            const choPhepSua = @(choPhepSua ? "true" : "false");
            const dsSanPham = @Html.Raw(danhSachSanPhamJson);
            const spMap = {};
            dsSanPham.forEach(function (sp) {
                spMap[sp.MaSP] = sp;
                $('#addMaSP').append(new Option(sp.MaSP + ' - ' + sp.TenSP, sp.MaSP, false, false));
            });

            let chiTietList = [];
            try {
                const parsed = JSON.parse($('#chiTietJson').val() || '[]');
                if (Array.isArray(parsed)) {
                    chiTietList = parsed.map(function (item) {
                        const info = spMap[item.MaSP] || {};
                        return {
                            MaSP: item.MaSP,
                            TenSP: info.TenSP || item.MaSP,
                            SoLuongNhap: parseInt(item.SoLuongNhap, 10) || 0,
                            DonGiaNhap: parseIntNumber(item.DonGiaNhap)
                        };
                    }).filter(x => x.MaSP && x.SoLuongNhap > 0);
                }
            } catch {
                chiTietList = [];
            }

            const initialChiTietList = JSON.parse(JSON.stringify(chiTietList));
            const initialValues = {
                NgayNhap: $('#NgayNhap').val(),
                MaNCC: $('#MaNCC').val(),
                TrangThai: $('#TrangThai').val()
            };

            function parseIntNumber(raw) {
                if (raw === null || raw === undefined) return 0;
                const cleaned = String(raw).replace(/[^\d-]/g, '');
                const parsed = parseInt(cleaned, 10);
                return isNaN(parsed) || parsed < 0 ? 0 : parsed;
            }

            function formatDong(num) {
                return parseIntNumber(num).toLocaleString('vi-VN') + ' ₫';
            }

            function formatSoLuong(num) {
                return parseIntNumber(num).toLocaleString('vi-VN');
            }

            function applyTrangThaiColor() {
                const val = $('#TrangThai').val();
                const $select = $('#TrangThai');
                const $iconBox = $('#trangThaiIconBox');

                $select.removeClass('text-success text-danger');
                $iconBox.removeClass('text-success text-danger');

                if (val === '1') {
                    $select.addClass('text-success');
                    $iconBox.addClass('text-success');
                } else {
                    $select.addClass('text-danger');
                    $iconBox.addClass('text-danger');
                }
            }

            applyTrangThaiColor();
            $('#TrangThai').on('change', applyTrangThaiColor);

            $('.select2-lookup').select2({
                theme: 'bootstrap-5',
                width: '100%'
            });

            $('.select2-sp').select2({
                theme: 'bootstrap-5',
                width: '100%',
                placeholder: 'Chọn sản phẩm nhập hàng',
                allowClear: true
            });

            $('#addMaSP').on('change', function () {
                const maSP = $(this).val();
                const sp = spMap[maSP];
                $('#addTenSP').val(sp ? sp.TenSP : '');
            });

            $('.currency-input').on('focus', function () {
                const num = parseIntNumber($(this).val());
                $(this).val(num > 0 ? String(num) : '');
            });

            $('.currency-input').on('input', function () {
                $(this).val(String($(this).val()).replace(/\D/g, ''));
            });

            $('.currency-input').on('blur change', function () {
                $(this).val(formatDong($(this).val()));
            });

            function syncHiddenJson() {
                $('#chiTietJson').val(JSON.stringify(chiTietList.map(x => ({
                    MaSP: x.MaSP,
                    SoLuongNhap: x.SoLuongNhap,
                    DonGiaNhap: x.DonGiaNhap
                }))));
            }

            function renderChiTietTable() {
                const $tbody = $('#chiTietBody');
                $tbody.empty();
                let tongTien = 0;

                if (chiTietList.length === 0) {
                    const colSpan = choPhepSua ? 7 : 6;
                    $tbody.append(
                        '<tr><td colspan="' + colSpan + '" class="text-center text-muted py-3">Không có chi tiết sản phẩm.</td></tr>'
                    );
                } else {
                    chiTietList.forEach(function (item, idx) {
                        const thanhTien = item.SoLuongNhap * item.DonGiaNhap;
                        tongTien += thanhTien;

                        let rowHtml =
                            '<tr>' +
                            '<td class="text-center fw-semibold text-muted">' + (idx + 1) + '</td>' +
                            '<td class="fw-bold text-success text-nowrap">' + $('<div>').text(item.MaSP).html() + '</td>' +
                            '<td class="fw-semibold text-dark">' + $('<div>').text(item.TenSP).html() + '</td>';

                        if (choPhepSua) {
                            rowHtml +=
                                '<td class="text-end">' +
                                '<input type="number" min="1" step="1" class="form-control form-control-sm text-end fw-semibold row-qty-input inline-qty-input" data-index="' + idx + '" value="' + item.SoLuongNhap + '" />' +
                                '</td>' +
                                '<td class="text-end">' +
                                '<input type="text" inputmode="numeric" class="form-control form-control-sm text-end fw-semibold row-price-input inline-price-input" data-index="' + idx + '" value="' + formatDong(item.DonGiaNhap) + '" autocomplete="off" />' +
                                '</td>';
                        } else {
                            rowHtml +=
                                '<td class="text-end fw-semibold">' + formatSoLuong(item.SoLuongNhap) + '</td>' +
                                '<td class="text-end">' + formatDong(item.DonGiaNhap) + '</td>';
                        }

                        rowHtml += '<td class="text-end fw-bold text-primary row-subtotal" data-index="' + idx + '">' + formatDong(thanhTien) + '</td>';

                        if (choPhepSua) {
                            rowHtml +=
                                '<td class="text-center">' +
                                '<button type="button" class="btn btn-sm btn-outline-danger btn-remove-ct" data-index="' + idx + '" title="Xóa dòng">' +
                                '<i class="bi bi-trash"></i>' +
                                '</button>' +
                                '</td>';
                        }

                        rowHtml += '</tr>';
                        $tbody.append(rowHtml);
                    });
                }

                $('#tongTienDisplay').text(formatDong(tongTien));
                syncHiddenJson();
            }

            function recalculateTotalsOnly() {
                let tongTien = 0;
                chiTietList.forEach(function (item, idx) {
                    const thanhTien = item.SoLuongNhap * item.DonGiaNhap;
                    tongTien += thanhTien;
                    $('.row-subtotal[data-index="' + idx + '"]').text(formatDong(thanhTien));
                });
                $('#tongTienDisplay').text(formatDong(tongTien));
                syncHiddenJson();
            }

            $('#chiTietTable').on('input change', '.row-qty-input', function () {
                if (!choPhepSua) return;
                const idx = parseInt($(this).data('index'), 10);
                if (isNaN(idx) || !chiTietList[idx]) return;
                let qty = parseInt($(this).val(), 10);
                if (isNaN(qty) || qty < 1) {
                    qty = 1;
                }
                chiTietList[idx].SoLuongNhap = qty;
                if ($(this).is(':focusout') || $(this).attr('type') === 'number') {
                    $(this).val(qty);
                }
                recalculateTotalsOnly();
            });

            $('#chiTietTable').on('focus', '.row-price-input', function () {
                if (!choPhepSua) return;
                const idx = parseInt($(this).data('index'), 10);
                if (isNaN(idx) || !chiTietList[idx]) return;
                $(this).val(chiTietList[idx].DonGiaNhap > 0 ? String(chiTietList[idx].DonGiaNhap) : '');
            });

            $('#chiTietTable').on('input', '.row-price-input', function () {
                if (!choPhepSua) return;
                const idx = parseInt($(this).data('index'), 10);
                if (isNaN(idx) || !chiTietList[idx]) return;
                const cleaned = String($(this).val()).replace(/\D/g, '');
                $(this).val(cleaned);
                chiTietList[idx].DonGiaNhap = parseIntNumber(cleaned);
                recalculateTotalsOnly();
            });

            $('#chiTietTable').on('blur change', '.row-price-input', function () {
                if (!choPhepSua) return;
                const idx = parseInt($(this).data('index'), 10);
                if (isNaN(idx) || !chiTietList[idx]) return;
                const price = parseIntNumber($(this).val());
                chiTietList[idx].DonGiaNhap = price;
                $(this).val(formatDong(price));
                recalculateTotalsOnly();
            });

            $('#btnAddChiTiet').on('click', function () {
                if (!choPhepSua) return;
                const maSP = $('#addMaSP').val();
                const soLuong = parseInt($('#addSoLuong').val(), 10) || 0;
                const giaNhap = parseIntNumber($('#addGiaNhap').val());

                if (!maSP) {
                    $('#addMaSP').select2('open');
                    return;
                }
                if (soLuong <= 0) {
                    $('#addSoLuong').trigger('focus');
                    return;
                }

                const sp = spMap[maSP];
                const existingIdx = chiTietList.findIndex(x => x.MaSP === maSP);
                if (existingIdx >= 0) {
                    chiTietList[existingIdx].SoLuongNhap += soLuong;
                    chiTietList[existingIdx].DonGiaNhap = giaNhap;
                } else {
                    chiTietList.push({
                        MaSP: maSP,
                        TenSP: sp ? sp.TenSP : maSP,
                        SoLuongNhap: soLuong,
                        DonGiaNhap: giaNhap
                    });
                }

                $('#addMaSP').val('').trigger('change');
                $('#addTenSP').val('');
                $('#addSoLuong').val('');
                $('#addGiaNhap').val(formatDong(0));
                renderChiTietTable();
            });

            $('#chiTietTable').on('click', '.btn-remove-ct', function () {
                if (!choPhepSua) return;
                const idx = parseInt($(this).data('index'), 10);
                if (!isNaN(idx) && idx >= 0) {
                    chiTietList.splice(idx, 1);
                    renderChiTietTable();
                }
            });

            const softModalEl = document.getElementById('softConfirmModal');
            const softModal = softModalEl ? bootstrap.Modal.getOrCreateInstance(softModalEl) : null;

            $('#btnResetEdit').on('click', function () {
                if (softModal) softModal.show();
            });

            $('#softConfirmOk').on('click', function () {
                if (softModal) softModal.hide();
                $('#NgayNhap').val(initialValues.NgayNhap);
                $('#MaNCC').val(initialValues.MaNCC).trigger('change');
                $('#TrangThai').val(initialValues.TrangThai).trigger('change');
                chiTietList = JSON.parse(JSON.stringify(initialChiTietList));
                renderChiTietTable();
            });

            const huyModalEl = document.getElementById('huyPhieuNhapModal');
            const huyModal = huyModalEl ? bootstrap.Modal.getOrCreateInstance(huyModalEl) : null;

            $('#btnOpenHuyModal').on('click', function () {
                if (huyModal) huyModal.show();
            });

            $('#editPhieuNhapForm').on('submit', function () {
                $('#addGiaNhap').trigger('blur');
                $('.row-price-input').trigger('blur');
                syncHiddenJson();
            });

            renderChiTietTable();
        });
    </script>
}