@model IEnumerable<MiniMart.Web.Models.PhieuNhap>
@using MiniMart.Web.Helpers
@using MiniMart.Web.Models
@using System.Globalization
@using System.Text.Json

@{
    ViewData["Title"] = "Danh sách phiếu nhập hàng";
    bool gioiHanSieuThi = ViewBag.GioiHanSieuThi as bool? == true;
    string? selectedMaST = ViewBag.SelectedMaST as string;
    var dsSieuThi = ViewBag.DanhSachSieuThi as IEnumerable<SieuThi>;
    var viVN = CultureInfo.GetCultureInfo("vi-VN");
    var tenSTHienTai = dsSieuThi?.FirstOrDefault(s => s.MaST == selectedMaST)?.TenST
        ?? Model?.FirstOrDefault(x => x.MaST == selectedMaST)?.SieuThiNavigation?.TenST
        ?? selectedMaST ?? "";
}

<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/datatables.net-bs5@1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet" />

<style>
    #phieuNhapTable tbody tr { cursor: pointer; }
    #phieuNhapTable thead .filter-row th { cursor: default; }
    #phieuNhapTable thead .filter-row th::before,
    #phieuNhapTable thead .filter-row th::after { display: none !important; }

    .top-filter-bar {
        background-color: #f8f9fa;
        border: 1px solid #eef0f2;
        border-radius: 10px;
        padding: 14px 18px;
    }

    .top-filter-col {
        width: 380px;
        max-width: 100%;
    }

    .top-filter-col .select2-container--bootstrap-5 .select2-selection--single .select2-selection__rendered {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .price-range-row {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
    }

    .price-range-row .form-control {
        width: 105px;
        padding-left: 6px;
        padding-right: 6px;
        font-size: 0.78rem;
    }
</style>

<div class="container-fluid px-4 mt-3">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- TIÊU ĐỀ & CÁC NÚT THAO TÁC -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h3 class="fw-bold mb-1 text-success" style="color: #198754 !important;">
                <i class="bi bi-file-earmark-plus me-2"></i> Danh Sách Phiếu Nhập Hàng
            </h3>
            <p class="text-success fw-bold small mb-0">
                @if (gioiHanSieuThi)
                {
                    <span>Quản lý phiếu nhập hàng, nhà cung cấp và trạng thái giao hàng thuộc siêu thị của bạn</span>
                }
                else
                {
                    <span>Quản lý phiếu nhập hàng, nhà cung cấp và trạng thái giao hàng trên toàn hệ thống</span>
                }
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <button type="button" id="btnXoaBoLoc" class="btn btn-outline-secondary fw-semibold bg-white shadow-sm">
                <i class="bi bi-arrow-counterclockwise me-1"></i> Xóa bộ lọc
            </button>

            @if (Html.HasPermission("WEB_HH_NH_THEM"))
            {
                <a asp-action="Create" class="btn btn-success fw-bold shadow-sm">
                    <i class="bi bi-plus-circle me-1"></i> Tạo Phiếu Nhập Hàng
                </a>
            }
        </div>
    </div>
    <hr />

    <!-- THANH FILTER TRÊN: SIÊU THỊ -->
    <div class="top-filter-bar mb-4">
        <div class="d-flex flex-wrap align-items-end gap-4">
            <div class="top-filter-col">
                <label for="filterTopSieuThi" class="form-label fw-semibold small text-dark mb-1">
                    <i class="bi bi-shop-window text-success me-1"></i> Siêu Thị
                </label>
                @if (gioiHanSieuThi)
                {
                    <select id="filterTopSieuThi" class="form-select form-select-sm bg-white" disabled>
                        <option value="@selectedMaST" selected>@tenSTHienTai (@selectedMaST)</option>
                    </select>
                }
                else
                {
                    <select id="filterTopSieuThi" class="form-select form-select-sm select2-top" style="width: 100%;">
                        <option value="">Tất cả siêu thị</option>
                        @if (dsSieuThi != null && dsSieuThi.Any())
                        {
                            @foreach (var st in dsSieuThi)
                            {
                                <option value="@st.MaST">@st.TenST (@st.MaST)</option>
                            }
                        }
                        else if (Model != null)
                        {
                            @foreach (var st in Model
                                .Select(x => new { MaST = x.MaST, TenST = x.SieuThiNavigation?.TenST ?? x.MaST })
                                .GroupBy(x => x.MaST)
                                .Select(g => g.First())
                                .OrderBy(x => x.TenST))
                            {
                                <option value="@st.MaST">@st.TenST (@st.MaST)</option>
                            }
                        }
                    </select>
                }
            </div>
        </div>
    </div>

    <!-- BẢNG DỮ LIỆU -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden mb-5">
        <div class="card-body p-3">
            <div class="table-responsive">
                <table id="phieuNhapTable" class="table table-hover table-bordered align-middle w-100">
                    <thead class="table-light text-secondary">
                        <tr>
                            <th class="text-center" style="width: 5%;">STT</th>
                            <th class="d-none">MaST</th>
                            <th>Mã Phiếu Nhập</th>
                            <th>Ngày Nhập</th>
                            <th>Nhà Cung Cấp</th>
                            <th>Nhân Viên</th>
                            <th class="text-end">Tổng Tiền Nhập</th>
                            <th class="text-center">Trạng Thái</th>
                        </tr>
                        <tr class="filter-row">
                            <th class="text-center"></th>
                            <th class="d-none"></th>
                            <th><input type="text" class="form-control form-control-sm column-search" data-col="2" placeholder="Nhập mã PN..." /></th>
                            <th><input type="text" class="form-control form-control-sm column-search" data-col="3" placeholder="Nhập ngày..." /></th>
                            <th><input type="text" class="form-control form-control-sm column-search" data-col="4" placeholder="Nhập NCC..." /></th>
                            <th><input type="text" class="form-control form-control-sm column-search" data-col="5" placeholder="Nhập nhân viên..." /></th>
                            <th class="text-center">
                                <div class="price-range-row">
                                    <input type="text" inputmode="numeric"
                                           class="form-control form-control-sm text-end price-range"
                                           data-bound="min" placeholder="Từ ..." autocomplete="off" />
                                    <span class="text-muted fw-bold">-</span>
                                    <input type="text" inputmode="numeric"
                                           class="form-control form-control-sm text-end price-range"
                                           data-bound="max" placeholder="Đến..." autocomplete="off" />
                                </div>
                            </th>
                            <th>
                                <select class="form-select form-select-sm select2-filter" data-col="7" style="width: 100%;">
                                    <option value="">Tất cả trạng thái</option>
                                    <option value="Chưa giao hàng">Chưa giao hàng</option>
                                    <option value="Đã giao hàng">Đã giao hàng</option>
                                </select>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            int chiSo = 1;
                            foreach (var item in Model)
                            {
                                var tenNCC = item.NhaCungCapNavigation?.TenNCC ?? item.MaNCC;
                                var tenNV = item.NhanVienNavigation?.HoTen ?? (string.IsNullOrWhiteSpace(item.MaNV) ? "---" : item.MaNV);
                                long tongTienInt = Convert.ToInt64(Math.Round(
                                    item.ChiTietPhieuNhaps.Sum(ct => ct.SoLuongNhap * ct.DonGiaNhap),
                                    0,
                                    MidpointRounding.AwayFromZero));

                                <tr data-mapn="@item.MaPN"
                                    data-tongtien="@tongTienInt">
                                    <td class="text-center fw-semibold text-muted">@chiSo</td>
                                    <td class="d-none">@item.MaST</td>
                                    <td class="fw-bold text-success">@item.MaPN</td>
                                    <td>@item.NgayNhap.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="fw-semibold text-dark">@tenNCC (@item.MaNCC)</td>
                                    <td>@tenNV</td>
                                    <td class="text-end fw-bold text-primary" data-order="@tongTienInt">@tongTienInt.ToString("N0", viVN) ₫</td>
                                    <td class="text-center">
                                        @if (item.TrangThai == 1)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                                Đã giao hàng
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1">
                                                Chưa giao hàng
                                            </span>
                                        }
                                    </td>
                                </tr>
                                chiSo++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/datatables.net@1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/datatables.net-bs5@1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(document).ready(function () {
            function parseRawPrice(raw) {
                if (raw === null || raw === undefined) return NaN;
                const cleaned = String(raw).replace(/\D/g, '');
                if (cleaned === '') return NaN;
                const num = parseInt(cleaned, 10);
                return isNaN(num) ? NaN : num;
            }

            function formatDongFilter(num) {
                if (isNaN(num)) return '';
                return num.toLocaleString('vi-VN') + ' ₫';
            }

            $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {
                if (settings.nTable.id !== 'phieuNhapTable') return true;

                var rowNode = settings.aoData[dataIndex]?.nTr;
                if (!rowNode) return true;

                var minVal = parseRawPrice($('.price-range[data-bound="min"]').val());
                var maxVal = parseRawPrice($('.price-range[data-bound="max"]').val());
                var cellVal = parseFloat($(rowNode).data('tongtien'));

                if (!isNaN(cellVal)) {
                    if (!isNaN(minVal) && cellVal < minVal) return false;
                    if (!isNaN(maxVal) && cellVal > maxVal) return false;
                }

                return true;
            });

            var table = $('#phieuNhapTable').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/vi.json",
                    "searchPlaceholder": "Nhập tìm kiếm...",
                    "emptyTable": "Không có dữ liệu phiếu nhập hàng phù hợp."
                },
                "orderCellsTop": true,
                "pageLength": 10,
                "columnDefs": [
                    { "orderable": false, "targets": [0, 6] },
                    { "visible": false, "targets": [1] }
                ],
                "order": [[3, 'desc']]
            });

            table.on('draw.dt', function () {
                var start = table.page.info().start;
                table.column(0, { search: 'applied', order: 'applied', page: 'current' })
                    .nodes().each(function (cell, i) {
                        cell.innerHTML = start + i + 1;
                    });
            }).draw();

            $('.select2-top, .select2-filter').select2({
                theme: 'bootstrap-5',
                width: '100%',
                minimumResultsForSearch: 0
            });

            $('.filter-row').on('click', 'input, select, .select2, .select2-selection', function (e) {
                e.stopPropagation();
            });

            $('#filterTopSieuThi').on('change', function () {
                var maST = $(this).val();
                if (!maST) {
                    table.column(1).search('').draw();
                } else {
                    var regex = '^\\s*' + $.fn.dataTable.util.escapeRegex(maST) + '\\s*$';
                    table.column(1).search(regex, true, false).draw();
                }
            });

            $('.column-search').on('keyup change clear', function () {
                table.column($(this).data('col')).search(this.value).draw();
            });

            $('.price-range').on('focus', function () {
                const num = parseRawPrice($(this).val());
                $(this).val(isNaN(num) ? '' : String(num));
            });

            $('.price-range').on('input', function () {
                const cleaned = String($(this).val()).replace(/\D/g, '');
                $(this).val(cleaned);
                table.draw();
            });

            $('.price-range').on('blur change', function () {
                const num = parseRawPrice($(this).val());
                $(this).val(isNaN(num) ? '' : formatDongFilter(num));
                table.draw();
            });

            $('.select2-filter').on('change', function () {
                var colIndex = $(this).data('col');
                var giaTri = $(this).val();
                if (!giaTri) {
                    table.column(colIndex).search('').draw();
                } else {
                    var regex = '^\\s*' + $.fn.dataTable.util.escapeRegex(giaTri) + '\\s*$';
                    table.column(colIndex).search(regex, true, false).draw();
                }
            });

            $('#btnXoaBoLoc').on('click', function () {
                @if (!gioiHanSieuThi)
                {
                    <text>$('#filterTopSieuThi').val('').trigger('change.select2');</text>
                }
                $('.column-search').val('');
                $('.price-range').val('');
                $('.select2-filter').val('').trigger('change.select2');

                table.search('').columns().search('');
                @if (gioiHanSieuThi && !string.IsNullOrEmpty(selectedMaST))
                {
                    <text>
                    var stRegex = '^\\s*' + $.fn.dataTable.util.escapeRegex('@selectedMaST') + '\\s*$';
                    table.column(1).search(stRegex, true, false);
                    </text>
                }
                table.draw();
            });

            $('#phieuNhapTable tbody').on('click', 'tr', function () {
                var maPN = $(this).data('mapn');
                if (!maPN) return;

                @if (Html.HasPermission("WEB_HH_NH_XEM"))
                {
                    <text>
                    window.location.href = '/NhapHang/Edit/' + encodeURIComponent(maPN);
                    </text>
                }
                else
                {
                    <text>
                    var modalEl = document.getElementById('permissionErrorModal');
                    if (modalEl) {
                        bootstrap.Modal.getOrCreateInstance(modalEl).show();
                    }
                    </text>
                }
            });

            @if (TempData["ForeignKeyDeleteError"] != null)
            {
                <text>
                const fkModalEl = document.getElementById('foreignKeyDeleteErrorModal');
                if (fkModalEl) {
                    const msgEl = document.getElementById('foreignKeyDeleteErrorMessage');
                    if (msgEl) {
                        msgEl.textContent = @Html.Raw(JsonSerializer.Serialize(TempData["ForeignKeyDeleteError"]!.ToString()));
                    }
                    bootstrap.Modal.getOrCreateInstance(fkModalEl).show();
                }
                </text>
            }
        });
    </script>
}