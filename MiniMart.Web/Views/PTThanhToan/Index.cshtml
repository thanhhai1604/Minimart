@model IEnumerable<MiniMart.Web.Models.PTThanhToan>
@using MiniMart.Web.Helpers

@{
    ViewData["Title"] = "Danh sách phương thức thanh toán";
}

<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/datatables.net-bs5@1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet" />

<style>
    #ptttTable tbody tr { cursor: pointer; }
    #ptttTable thead .filter-row th { cursor: default; }
    #ptttTable thead .filter-row th::before,
    #ptttTable thead .filter-row th::after { display: none !important; }
</style>

<div class="container-fluid px-4 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="fw-bold mb-0 text-success" style="color: #198754 !important;">
                <i class="bi bi-wallet2 me-2"></i> Danh Sách Phương Thức Thanh Toán
            </h3>
            <p class="text-success fw-bold small mb-0">
                Quản lý các hình thức thanh toán giao dịch trong hệ thống
            </p>
        </div>
        <div class="d-flex gap-2">
            <button id="btnXoaBoLoc" class="btn btn-outline-secondary fw-semibold shadow-sm">
                <i class="bi bi-arrow-counterclockwise me-1"></i> Xóa bộ lọc
            </button>
            
            @if (Html.HasPermission("WEB_HT_PTTT_THEM"))
            {
                <a asp-action="Create" class="btn btn-success fw-bold shadow-sm">
                    <i class="bi bi-plus-lg me-1"></i> Thêm phương thức
                </a>
            }
        </div>
    </div>
    <hr />

    <div class="card border-0 shadow-sm rounded-3 overflow-hidden mb-5">
        <div class="card-body p-3">
            <div class="table-responsive">
                <table id="ptttTable" class="table table-hover table-bordered align-middle w-100">
                    <thead class="table-light text-secondary">
                        <tr>
                            <th class="text-center" style="width: 5%;">STT</th>
                            <th>Mã PTTT</th>
                            <th>Tên Phương Thức Thanh Toán</th>
                            <th class="text-center">Trạng Thái</th>
                        </tr>
                        <tr class="filter-row">
                            <th class="text-center"></th>
                            <th><input type="text" class="form-control form-control-sm column-search" data-col="1" placeholder="Nhập mã..." /></th>
                            <th><input type="text" class="form-control form-control-sm column-search" data-col="2" placeholder="Nhập tên..." /></th>
                            <th>
                                <select class="form-select form-select-sm select2-filter" data-col="3" style="width: 100%;">
                                    <option value="">Tất cả trạng thái</option>
                                    <option value="Sử dụng">Sử dụng</option>
                                    <option value="Không sử dụng">Không sử dụng</option>
                                </select>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            int chiSo = 1;
                            foreach (var item in Model)
                            {
                                <tr data-id="@item.MaPTTT">
                                    <td class="text-center fw-semibold text-muted">@chiSo</td>
                                    <td class="fw-bold text-success font-monospace">@item.MaPTTT</td>
                                    <td class="fw-semibold text-dark">@item.TenPTTT</td>
                                    <td class="text-center">
                                        @if (item.TrangThai == 1)
                                        {
                                            <span class="badge bg-primary px-3 py-1">Sử dụng</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary px-3 py-1">Không sử dụng</span>
                                        }
                                    </td>
                                </tr>
                                chiSo++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/datatables.net@1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/datatables.net-bs5@1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(document).ready(function () {
            var table = $('#ptttTable').DataTable({
                "language": { "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/vi.json" },
                "orderCellsTop": true,
                "columnDefs": [{ "orderable": false, "targets": 0 }],
                "order": [[1, 'asc']]
            });

            table.on('draw.dt', function () {
                var start = table.page.info().start;
                table.column(0, { search: 'applied', order: 'applied', page: 'current' })
                    .nodes().each(function (cell, i) { cell.innerHTML = start + i + 1; });
            }).draw();

            $('.select2-filter').select2({ theme: 'bootstrap-5', width: '100%', minimumResultsForSearch: Infinity });

            $('.filter-row').on('click', 'input, select, .select2, .select2-selection', function (e) {
                e.stopPropagation();
            });

            $('.column-search').on('keyup change clear', function () {
                table.column($(this).data('col')).search(this.value).draw();
            });

            $('.select2-filter').on('change', function () {
                var colIndex = $(this).data('col');
                var giaTri = $(this).val();
                if (!giaTri) {
                    table.column(colIndex).search('').draw();
                } else {
                    var regex = '^\\s*' + $.fn.dataTable.util.escapeRegex(giaTri) + '\\s*$';
                    table.column(colIndex).search(regex, true, false).draw();
                }
            });

            $('#btnXoaBoLoc').on('click', function () {
                $('.column-search').val('');
                $('.select2-filter').val('').trigger('change.select2');
                table.search('').columns().search('').draw();
            });

            $('#ptttTable tbody').on('click', 'tr', function () {
                @if (Html.HasPermission("WEB_HT_PTTT_XEM") || Html.HasPermission("WEB_HT_PTTT_SUA"))
                {
                    <text>
                    var maPTTT = $(this).data('id');
                    if (maPTTT) { window.location.href = '/PTThanhToan/Edit/' + maPTTT; }
                    </text>
                }
                else
                {
                    <text>
                    var permissionModal = new bootstrap.Modal(document.getElementById('permissionErrorModal'));
                    permissionModal.show();
                    </text>
                }
            });
        });
    </script>
}