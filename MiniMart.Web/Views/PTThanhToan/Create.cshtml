@model MiniMart.Web.Models.PTThanhToan

@{
    ViewData["Title"] = "Thêm mới phương thức thanh toán";
}

<div class="container-fluid px-4 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="fw-bold mb-0 text-success" style="color: #198754 !important;">
                Thêm Mới Phương Thức Thanh Toán
            </h3>
            <p class="text-success fw-bold small mb-0">
                Thêm hình thức thanh toán mới vào hệ thống
            </p>
        </div>

        <div class="d-flex gap-2">
            <button type="button" id="btnResetForm" class="btn btn-outline-secondary fw-semibold shadow-sm">
                <i class="bi bi-eraser me-1"></i> Xóa nhập liệu
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary fw-semibold shadow-sm scalable back">
                <i class="bi bi-arrow-left me-1"></i> Quay lại
            </a>
        </div>
    </div>
    <hr />

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" id="ptttForm">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="MaPTTT" class="form-label fw-semibold small text-secondary">Mã Phương Thức <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-success"><i class="bi bi-code-square"></i></span>
                                <input asp-for="MaPTTT" class="form-control bg-light border-start-0 ps-0" placeholder="Ví dụ: ZALOPAY, QRCODE..." autocomplete="off" id="MaPTTT" />
                            </div>
                            <span asp-validation-for="MaPTTT" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="TenPTTT" class="form-label fw-semibold small text-secondary">Tên Phương Thức Thanh Toán <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-success"><i class="bi bi-wallet2"></i></span>
                                <input asp-for="TenPTTT" class="form-control bg-light border-start-0 ps-0" placeholder="Nhập tên phương thức..." autocomplete="off" />
                            </div>
                            <span asp-validation-for="TenPTTT" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="TrangThai" class="form-label fw-semibold small text-secondary">Trạng Thái</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-success"><i class="bi bi-toggle-on"></i></span>
                                <select asp-for="TrangThai" class="form-select bg-light border-start-0">
                                    <option value="1">Sử dụng</option>
                                    <option value="0">Không sử dụng</option>
                                </select>
                            </div>
                            <span asp-validation-for="TrangThai" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-end align-items-center border-top pt-3">
                            <button type="submit" class="btn btn-success px-4 fw-bold shadow-sm">
                                <i class="bi bi-save me-1"></i> Lưu thông tin
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }

    <script>
        $(document).ready(function () {
            const clearModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('clearFormConfirmModal'));

            $('#btnResetForm').on('click', function () {
                clearModal.show();
            });

            $('#clearFormConfirmOk').on('click', function () {
                clearModal.hide();
                var $form = $('#ptttForm');
                $form.find('input[type="text"]').val('');
                $form.find('select').prop('selectedIndex', 0);
                $form.find('.field-validation-error').empty();
                $form.find('.input-validation-error').removeClass('input-validation-error');
                $('#MaPTTT').trigger('focus');
            });
        });
    </script>
}