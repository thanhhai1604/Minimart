@model MiniMart.Web.Models.NhaCungCap
@using MiniMart.Web.Helpers

@{
    ViewData["Title"] = "Cập nhật nhà cung cấp";
    bool coSua = Html.HasPermission("WEB_QL_NCC_SUA");
}

<div class="container-fluid px-4 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="fw-bold mb-0 text-success" style="color: #198754 !important;">
                Cập Nhật Nhà Cung Cấp
            </h3>
            <p class="text-success fw-bold small mb-0">
                Chỉnh sửa thông tin đối tác cung cấp hàng hóa hệ thống
            </p>
        </div>

        <div class="d-flex gap-2">
            @if (coSua)
            {
                <button type="button" id="btnResetEdit" class="btn btn-outline-secondary fw-semibold shadow-sm">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Khôi phục ban đầu
                </button>
            }
            <a asp-action="Index" class="btn btn-outline-secondary fw-semibold shadow-sm scalable back">
                <i class="bi bi-arrow-left me-1"></i> Quay lại
            </a>
        </div>
    </div>
    <hr />

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post" id="editForm">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3" role="alert"></div>

                        <input type="hidden" asp-for="MaNCC" />

                        <fieldset disabled="@(!coSua)">

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold small text-secondary">Mã NCC</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-secondary"><i class="bi bi-code-square"></i></span>
                                    <input type="text" class="form-control bg-light border-start-0 ps-0 text-muted" value="@Model.MaNCC" disabled />
                                </div>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="TenNCC" class="form-label fw-semibold small text-secondary">Tên Nhà Cung Cấp <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-success"><i class="bi bi-truck"></i></span>
                                    <input asp-for="TenNCC" class="form-control bg-light border-start-0 ps-0" placeholder="Nhập tên nhà cung cấp..." autocomplete="off" id="TenNCC" />
                                </div>
                                <span asp-validation-for="TenNCC" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="SoDT" class="form-label fw-semibold small text-secondary">Số Điện Thoại</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-success"><i class="bi bi-telephone"></i></span>
                                    <input asp-for="SoDT" class="form-control bg-light border-start-0 ps-0" placeholder="Nhập số điện thoại..." autocomplete="off" maxlength="11" id="SoDT" />
                                </div>
                                <span asp-validation-for="SoDT" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label fw-semibold small text-secondary">Email</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-success"><i class="bi bi-envelope"></i></span>
                                    <input asp-for="Email" class="form-control bg-light border-start-0 ps-0" placeholder="Nhập địa chỉ email..." autocomplete="off" id="Email" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12 mb-4">
                                <label asp-for="Diachi" class="form-label fw-semibold small text-secondary">Địa Chỉ</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-success"><i class="bi bi-geo-alt"></i></span>
                                    <input asp-for="Diachi" class="form-control bg-light border-start-0 ps-0" placeholder="Nhập địa chỉ nhà cung cấp..." autocomplete="off" id="Diachi" />
                                </div>
                                <span asp-validation-for="Diachi" class="text-danger small"></span>
                            </div>
                        </div>

                        </fieldset>

                        <div class="d-flex justify-content-between align-items-center border-top pt-3">
                            <div>
                                @if (Html.HasPermission("WEB_QL_NCC_XOA"))
                                {
                                    <button type="button" class="btn btn-danger text-white fw-bold shadow-sm px-3" id="btnOpenDeleteModal">
                                        <i class="bi bi-trash me-1"></i> Xóa nhà cung cấp
                                    </button>
                                }
                            </div>

                            <div>
                                @if (coSua)
                                {
                                    <button type="submit" class="btn btn-success px-4 fw-bold shadow-sm">
                                        <i class="bi bi-save me-1"></i> Lưu thay đổi
                                    </button>
                                }
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@if (Html.HasPermission("WEB_QL_NCC_XOA"))
{
    <div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-3">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i> Xác nhận xóa nhà cung cấp!</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-secondary mb-3">Bạn chắc chắn muốn xóa nhà cung cấp sau khỏi hệ thống?</p>
                    <div class="bg-light p-3 rounded-3 border">
                        <ul class="list-unstyled mb-0 small">
                            <li class="mb-2">Mã NCC: <span class="text-dark fw-bold">@Model.MaNCC</span></li>
                            <li class="mb-2">Tên NCC: <span class="text-dark fw-bold">@Model.TenNCC</span></li>
                            <li class="mb-2">Số điện thoại: <span class="text-dark fw-bold">@(string.IsNullOrEmpty(Model.SoDT) ? "Chưa cập nhật" : Model.SoDT)</span></li>
                            <li class="mb-2">Email: <span class="text-dark fw-bold">@(string.IsNullOrEmpty(Model.Email) ? "Chưa cập nhật" : Model.Email)</span></li>
                            <li class="mb-0">Địa chỉ: <span class="text-dark fw-bold">@(string.IsNullOrEmpty(Model.Diachi) ? "Chưa cập nhật" : Model.Diachi)</span></li>
                        </ul>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0">
                    <button type="button" class="btn btn-secondary px-3 fw-bold" data-bs-dismiss="modal">Hủy bỏ</button>
                    <form asp-action="Delete" asp-route-id="@Model.MaNCC" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger text-white px-4 fw-bold shadow-sm">
                            <i class="bi bi-trash me-1"></i> Xác nhận
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        $(document).ready(function () {
            const initialValues = {
                TenNCC: $('#TenNCC').val(),
                SoDT: $('#SoDT').val(),
                Email: $('#Email').val(),
                Diachi: $('#Diachi').val()
            };

            const softModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('softConfirmModal'));
            
            $('#btnResetEdit').on('click', function () { 
                softModal.show(); 
            });

            $('#softConfirmOk').on('click', function () {
                softModal.hide();
                $('#TenNCC').val(initialValues.TenNCC);
                $('#SoDT').val(initialValues.SoDT);
                $('#Email').val(initialValues.Email);
                $('#Diachi').val(initialValues.Diachi);
            });

            const btnOpenDeleteModal = document.getElementById('btnOpenDeleteModal');
            const deleteModalElement = document.getElementById('deleteConfirmModal');
            if (btnOpenDeleteModal && deleteModalElement) {
                const deleteModal = bootstrap.Modal.getOrCreateInstance(deleteModalElement);
                btnOpenDeleteModal.addEventListener('click', function () { deleteModal.show(); });
            }
        });
    </script>
}