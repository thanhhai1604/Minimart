@model MiniMart.Web.Models.VaiTroDetails
@using MiniMart.Web.Helpers

@{
    ViewData["Title"] = "Cập nhật vai trò";
    var webQuyens = Model.DanhSachQuyen.Where(x => x.NenTang == "WEB").ToList();
    var posQuyens = Model.DanhSachQuyen.Where(x => x.NenTang == "POS").ToList();

    var dsSieuThi = Model.DanhSachNhanVien
        .Select(x => string.IsNullOrEmpty(x.TenST) ? "Tất cả siêu thị" : x.TenST)
        .Distinct()
        .OrderBy(x => x)
        .ToList();
}

<!-- Select2 & DataTables (Bootstrap 5) -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/datatables.net-bs5@1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet" />

<style>
    /* ===== Menu trái: màu khi chọn ===== */
    #roleTabList .list-group-item {
        color: #495057;
        background-color: transparent;
        transition: background-color .15s, color .15s;
    }
    #roleTabList .list-group-item:hover {
        background-color: #f1f8f4;
        color: #198754;
    }
    #roleTabList .list-group-item.active {
        background-color: #e8f5e9;
        color: #146c43;
        box-shadow: inset 4px 0 0 #198754;
    }
    #roleTabList .list-group-item.active i {
        color: #198754 !important;
    }

    /* ===== Tab nền tảng (Back Office / POS) ===== */
    #platformTab .nav-link {
        color: #495057;
        background-color: #f1f3f5;
    }
    #platformTab .nav-link:hover {
        background-color: #e8f5e9;
        color: #198754 !important;
    }
    #platformTab .nav-link.active,
    #platformTab .nav-link.active:hover {
        background-color: #198754;
        color: #ffffff !important;
    }

    /* ===== Giới hạn chiều cao TreeView (~30 dòng) có scrollbar riêng ===== */
    .treeview-scroll-box {
        max-height: 450px;
        overflow-y: auto;
        border: 1px solid #dee2e6;
        border-radius: 0.375rem;
        background-color: #f8f9fa;
        padding: 12px;
    }

    #nhanVienVaiTroTable thead .filter-row th {
        cursor: default;
        font-weight: normal;
    }
    #nhanVienVaiTroTable thead .filter-row th::before,
    #nhanVienVaiTroTable thead .filter-row th::after {
        display: none !important;
    }
</style>

<div class="container-fluid px-4 mt-4">
    <form asp-action="Edit" method="post" id="vaiTroForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="MaVaiTro" />

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h3 class="fw-bold mb-0 text-success" style="color: #198754 !important;">
                    <i class="bi bi-shield-lock-fill me-2"></i> Cập Nhật Vai Trò
                </h3>
                <p class="text-success fw-bold small mb-0">Chỉnh sửa thông tin vai trò và phân quyền hệ thống</p>
            </div>
            <div class="d-flex gap-2">
                <!-- Nút Khôi phục ban đầu gọi Popup số 4 từ Layout chung -->
                <button type="button" class="btn btn-outline-secondary fw-semibold shadow-sm" id="btnKhoiPhuc">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Khôi phục ban đầu
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary fw-semibold shadow-sm">
                    <i class="bi bi-arrow-left me-1"></i> Quay lại
                </a>
            </div>
        </div>
        <hr />

        <div class="row">
            <!-- LEFT SIDE PANEL -->
            <div class="col-md-3 mb-4">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body p-2">
                        <div class="list-group list-group-flush rounded-2" id="roleTabList" role="tablist">
                            <a class="list-group-item list-group-item-action active fw-semibold py-3 border-0 rounded-2 mb-1" id="tab-thong-tin" data-bs-toggle="list" href="#content-thong-tin" role="tab">
                                <i class="bi bi-info-circle-fill me-2 text-success"></i> Thông tin vai trò
                            </a>
                            <a class="list-group-item list-group-item-action fw-semibold py-3 border-0 rounded-2" id="tab-phan-quyen" data-bs-toggle="list" href="#content-phan-quyen" role="tab">
                                <i class="bi bi-key-fill me-2 text-success"></i> Phân quyền vai trò
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- RIGHT CONTENT AREA -->
            <div class="col-md-9">
                <div class="tab-content">

                    <!-- TAB 1: THÔNG TIN VAI TRÒ & NHÂN VIÊN -->
                    <div class="tab-pane fade show active" id="content-thong-tin" role="tabpanel">
                        <div class="card border-0 shadow-sm rounded-3 mb-4">
                            <div class="card-header bg-white py-3 border-0">
                                <h5 class="fw-bold text-dark mb-0"><i class="bi bi-card-text me-2 text-success"></i> Thông tin chung</h5>
                            </div>
                            <div class="card-body px-4 pb-4 pt-0">
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-semibold small text-secondary">Mã Vai Trò</label>
                                        <input type="text" class="form-control bg-light text-muted" value="@Model.MaVaiTro" disabled />
                                        <span class="text-muted" style="font-size: 0.75rem;">Mã vai trò không thể thay đổi.</span>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="TenVaiTro" class="form-label fw-semibold small text-secondary">Tên Vai Trò <span class="text-danger">*</span></label>
                                        <input asp-for="TenVaiTro" class="form-control bg-light" placeholder="Nhập tên vai trò..." autocomplete="off" />
                                        <span asp-validation-for="TenVaiTro" class="text-danger small"></span>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-12 mb-2">
                                        <label asp-for="MoTa" class="form-label fw-semibold small text-secondary">Mô Tả Vai Trò</label>
                                        <textarea asp-for="MoTa" class="form-control bg-light" rows="3" placeholder="Nhập mô tả chi tiết..."></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Danh sách nhân viên thuộc vai trò -->
                        <div class="card border-0 shadow-sm rounded-3 mb-4">
                            <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <h5 class="fw-bold text-dark mb-0"><i class="bi bi-people-fill me-2 text-success"></i> Danh sách nhân viên thuộc vai trò</h5>
                                <div class="d-flex align-items-center gap-2">
                                    <button type="button" id="btnXoaBoLoc" class="btn btn-outline-secondary btn-sm fw-semibold">
                                        <i class="bi bi-funnel me-1"></i> Xóa bộ lọc
                                    </button>
                                    <span class="badge bg-success-subtle text-success px-3 py-2 fw-semibold">Tổng số: @Model.DanhSachNhanVien.Count</span>
                                </div>
                            </div>
                            <div class="card-body px-4 pb-4 pt-0">
                                <div class="table-responsive">
                                    <table id="nhanVienVaiTroTable" class="table table-hover table-bordered align-middle w-100">
                                        <thead class="table-light text-secondary">
                                            <tr>
                                                <th class="text-center" style="width: 6%;">STT</th>
                                                <th>Mã Nhân Viên</th>
                                                <th>Tên Nhân Viên</th>
                                                <th>Tên Đăng Nhập</th>
                                                <th>Số Điện Thoại</th>
                                                <th>Siêu Thị Trực Thuộc</th>
                                                <th class="text-center">Trạng Thái</th>
                                            </tr>
                                            <tr class="filter-row">
                                                <th></th>
                                                <th><input type="text" class="form-control form-control-sm column-search" data-col="1" placeholder="Nhập mã nhân viên..." /></th>
                                                <th><input type="text" class="form-control form-control-sm column-search" data-col="2" placeholder="Nhập tên nhân viên..." /></th>
                                                <th><input type="text" class="form-control form-control-sm column-search" data-col="3" placeholder="Nhập tên đăng nhập..." /></th>
                                                <th><input type="text" class="form-control form-control-sm column-search" data-col="4" placeholder="Nhập số điện thoại..." /></th>
                                                <th>
                                                    <select class="form-select form-select-sm select2-filter" data-col="5" style="width: 100%;">
                                                        <option value="">Tất cả siêu thị</option>
                                                        @foreach (var tenST in dsSieuThi)
                                                        {
                                                            <option value="@tenST">@tenST</option>
                                                        }
                                                    </select>
                                                </th>
                                                <th class="text-center">
                                                    <select class="form-select form-select-sm select2-filter" data-col="6" style="width: 100%;">
                                                        <option value="">Tất cả trạng thái</option>
                                                        <option value="Đang làm việc">Đang làm việc</option>
                                                        <option value="Ngừng làm việc">Ngừng làm việc</option>
                                                    </select>
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{ int chiSo = 1; }
                                            @foreach (var nv in Model.DanhSachNhanVien)
                                            {
                                                <tr>
                                                    <td class="text-center fw-semibold text-muted">@chiSo</td>
                                                    <td class="fw-bold text-success">@nv.MaNV</td>
                                                    <td class="fw-semibold text-dark">@nv.HoTen</td>
                                                    <td class="text-muted">@nv.TenDN</td>
                                                    <td>@nv.SoDT</td>
                                                    <td><span class="text-primary fw-semibold">@(string.IsNullOrEmpty(nv.TenST) ? "Tất cả siêu thị" : nv.TenST)</span></td>
                                                    <td class="text-center">
                                                        @if (nv.TrangThai == 1)
                                                        {
                                                            <span class="badge bg-primary px-2 py-1">Đang làm việc</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary px-2 py-1">Ngừng làm việc</span>
                                                        }
                                                    </td>
                                                </tr>
                                                chiSo++;
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- TAB 2: PHÂN QUYỀN VAI TRÒ -->
                    <div class="tab-pane fade" id="content-phan-quyen" role="tabpanel">
                        <div class="card border-0 shadow-sm rounded-3 mb-4">
                            <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <ul class="nav nav-pills card-header-pills gap-2 mb-0" id="platformTab" role="tablist">
                                    <li class="nav-item" role="presentation">
                                        <button class="nav-link active fw-semibold px-4 py-2" id="backoffice-tab" data-bs-toggle="pill" data-bs-target="#backoffice-pane" type="button" role="tab">
                                            <i class="bi bi-laptop me-1"></i> Back Office (Web)
                                        </button>
                                    </li>
                                    <li class="nav-item" role="presentation">
                                        <button class="nav-link fw-semibold px-4 py-2" id="pos-tab" data-bs-toggle="pill" data-bs-target="#pos-pane" type="button" role="tab">
                                            <i class="bi bi-shop me-1"></i> POS (Máy bán hàng)
                                        </button>
                                    </li>
                                </ul>
                            </div>

                            <div class="card-body px-4 pb-4">
                                <div class="tab-content" id="platformTabContent">

                                    <!-- TAB PANE BACK OFFICE -->
                                    <div class="tab-pane fade show active" id="backoffice-pane" role="tabpanel">
                                        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                                            <div class="alert alert-light border small text-muted mb-0 py-2">
                                                <i class="bi bi-info-circle text-primary me-1"></i> Tích chọn các quyền hạn cho phép nền tảng Back Office.
                                            </div>
                                            <!-- Cụm nút điều khiển tách biệt cho Back Office -->
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="btn-group btn-group-sm shadow-sm" role="group">
                                                    <button type="button" class="btn btn-outline-success fw-semibold" id="btnSelectAllWeb">
                                                        <i class="bi bi-check2-all me-1"></i> Chọn tất cả
                                                    </button>
                                                    <button type="button" class="btn btn-outline-danger fw-semibold" id="btnDeselectAllWeb">
                                                        <i class="bi bi-x-lg me-1"></i> Bỏ chọn
                                                    </button>
                                                </div>
                                                <button type="button" class="btn btn-outline-dark btn-sm fw-semibold shadow-sm px-3" id="btnToggleExpandWeb" title="Thu gọn / Mở rộng">
                                                    <i class="bi bi-arrows-expand me-1" id="iconExpandWeb"></i> <span id="textExpandWeb">Mở rộng</span>
                                                </button>
                                            </div>
                                        </div>
                                        <div class="treeview-container treeview-scroll-box" id="treeBoxWeb">
                                            <partial name="_PermissionTreePartial" model="webQuyens" />
                                        </div>
                                    </div>

                                    <!-- TAB PANE POS -->
                                    <div class="tab-pane fade" id="pos-pane" role="tabpanel">
                                        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                                            <div class="alert alert-light border small text-muted mb-0 py-2">
                                                <i class="bi bi-info-circle text-primary me-1"></i> Tích chọn các quyền hạn cho phép nền tảng POS bán hàng.
                                            </div>
                                            <!-- Cụm nút điều khiển tách biệt cho POS -->
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="btn-group btn-group-sm shadow-sm" role="group">
                                                    <button type="button" class="btn btn-outline-success fw-semibold" id="btnSelectAllPos">
                                                        <i class="bi bi-check2-all me-1"></i> Chọn tất cả
                                                    </button>
                                                    <button type="button" class="btn btn-outline-danger fw-semibold" id="btnDeselectAllPos">
                                                        <i class="bi bi-x-lg me-1"></i> Bỏ chọn
                                                    </button>
                                                </div>
                                                <button type="button" class="btn btn-outline-dark btn-sm fw-semibold shadow-sm px-3" id="btnToggleExpandPos" title="Thu gọn / Mở rộng">
                                                    <i class="bi bi-arrows-expand me-1" id="iconExpandPos"></i> <span id="textExpandPos">Mở rộng</span>
                                                </button>
                                            </div>
                                        </div>
                                        <div class="treeview-container treeview-scroll-box" id="treeBoxPos">
                                            <partial name="_PermissionTreePartial" model="posQuyens" />
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- CTA BUTTON BAR -->
                <div class="card border-0 shadow-sm rounded-3 mb-5">
                    <div class="card-body d-flex justify-content-between align-items-center py-3">
                        <div>
                            @if (Html.HasPermission("WEB_HT_VT_XOA"))
                            {
                                <button type="button" class="btn btn-danger text-white fw-bold shadow-sm px-4" id="btnOpenDeleteModal">
                                    <i class="bi bi-trash me-1"></i> Xóa vai trò
                                </button>
                            }
                        </div>
                        <div>
                            @if (Html.HasPermission("WEB_HT_VT_SUA"))
                            {
                                <button type="submit" class="btn btn-success px-4 fw-bold shadow-sm">
                                    <i class="bi bi-save me-1"></i> Lưu thay đổi
                                </button>
                            }
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </form>
</div>

<!-- ================================================= -->
<!-- MODAL XÁC NHẬN XÓA VAI TRÒ -->
<!-- ================================================= -->
@if (Html.HasPermission("WEB_HT_VT_XOA"))
{
    <div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-3">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i> Xác nhận xóa vai trò!</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-secondary mb-2">Bạn có chắc chắn muốn xóa vai trò này khỏi hệ thống?</p>
                    <div class="bg-light p-3 rounded-3 border">
                        <p class="mb-1">Mã vai trò: <strong class="text-dark">@Model.MaVaiTro</strong></p>
                        <p class="mb-0">Tên vai trò: <strong class="text-dark">@Model.TenVaiTro</strong></p>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0">
                    <button type="button" class="btn btn-secondary px-3 fw-bold" data-bs-dismiss="modal">Hủy bỏ</button>
                    <form asp-action="Delete" asp-route-id="@Model.MaVaiTro" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger text-white px-4 fw-bold shadow-sm">
                            <i class="bi bi-trash me-1"></i> Xác nhận xóa
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/datatables.net@1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/datatables.net-bs5@1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(document).ready(function () {

            // ===== 1. Bảng nhân viên thuộc vai trò (DataTables) =====
            var table = $('#nhanVienVaiTroTable').DataTable({
                "language": {
                    "emptyTable": "Chưa có nhân viên nào thuộc vai trò này.",
                    "zeroRecords": "Không tìm thấy nhân viên phù hợp.",
                    "lengthMenu": "Hiển thị _MENU_ dữ liệu",
                    "info": "Hiển thị _START_ tới _END_ của _TOTAL_ dữ liệu",
                    "infoEmpty": "Hiển thị 0 tới 0 của 0 dữ liệu",
                    "infoFiltered": "(lọc từ _MAX_ dữ liệu)",
                    "search": "Tìm kiếm:",
                    "searchPlaceholder": "Nhập tìm kiếm...",
                    "paginate": { "first": "Đầu", "last": "Cuối", "next": "Sau", "previous": "Trước" }
                },
                "orderCellsTop": true,
                "columnDefs": [
                    { "orderable": false, "targets": 0 }
                ],
                "order": [[1, 'asc']]
            });

            table.on('draw.dt', function () {
                var start = table.page.info().start;
                table.column(0, { search: 'applied', order: 'applied', page: 'current' })
                    .nodes().each(function (cell, i) {
                        cell.innerHTML = start + i + 1;
                    });
            }).draw();

            $('.select2-filter').select2({ theme: 'bootstrap-5', width: '100%', minimumResultsForSearch: 0 });

            $('.filter-row').on('click', 'input, select, .select2, .select2-selection', function (e) {
                e.stopPropagation();
            });

            $('.column-search').on('keydown', function (e) {
                if (e.key === 'Enter') e.preventDefault();
            });

            $('.column-search').on('keyup change clear', function () {
                table.column($(this).data('col')).search(this.value).draw();
            });

            $('.select2-filter').on('change', function () {
                var colIndex = $(this).data('col');
                var giaTri = $(this).val();
                if (!giaTri) {
                    table.column(colIndex).search('').draw();
                } else {
                    var regex = '^\\s*' + $.fn.dataTable.util.escapeRegex(giaTri) + '\\s*$';
                    table.column(colIndex).search(regex, true, false).draw();
                }
            });

            function xoaBoLoc() {
                $('.column-search').val('');
                $('.select2-filter').val('').trigger('change.select2');
                table.search('').columns().search('').draw();
            }
            $('#btnXoaBoLoc').on('click', xoaBoLoc);

            // ===== 2. Chức năng Chọn tất cả / Bỏ chọn độc lập cho từng tab TreeView =====
            $('#btnSelectAllWeb').on('click', function () {
                $('#backoffice-pane input[type="checkbox"]').prop('checked', true).trigger('change');
            });
            $('#btnDeselectAllWeb').on('click', function () {
                $('#backoffice-pane input[type="checkbox"]').prop('checked', false).trigger('change');
            });

            $('#btnSelectAllPos').on('click', function () {
                $('#pos-pane input[type="checkbox"]').prop('checked', true).trigger('change');
            });
            $('#btnDeselectAllPos').on('click', function () {
                $('#pos-pane input[type="checkbox"]').prop('checked', false).trigger('change');
            });

            // ===== 3. Chức năng Toggle Expand / Collapse độc lập =====
            function setupToggleExpand(btnId, boxId, iconId, textId) {
                let isExpanded = true;

                $(btnId).on('click', function () {
                    isExpanded = !isExpanded;
                    let $box = $(boxId);
                    if (isExpanded) {
                        $box.find('.collapse, .submenu, ul').addClass('show show-sub').css('display', 'block');
                        $(iconId).removeClass('bi-arrows-expand').addClass('bi-arrows-collapse');
                        $(textId).text('Thu gọn');
                    } else {
                        $box.find('.collapse, .submenu, ul').removeClass('show show-sub').css('display', 'none');
                        $(iconId).removeClass('bi-arrows-collapse').addClass('bi-arrows-expand');
                        $(textId).text('Mở rộng');
                    }
                });
            }

            setupToggleExpand('#btnToggleExpandWeb', '#treeBoxWeb', '#iconExpandWeb', '#textExpandWeb');
            setupToggleExpand('#btnToggleExpandPos', '#treeBoxPos', '#iconExpandPos', '#textExpandPos');

            // ===== 4. Modal xóa vai trò =====
            const btnDelete = document.getElementById('btnOpenDeleteModal');
            const deleteModalEl = document.getElementById('deleteConfirmModal');
            if (btnDelete && deleteModalEl) {
                const deleteModal = bootstrap.Modal.getOrCreateInstance(deleteModalEl);
                btnDelete.addEventListener('click', function () { deleteModal.show(); });
            }

            // ===== 5. Khôi phục dữ liệu ban đầu (Gọi Popup số 4 chuẩn từ Layout chung) =====
            var softModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('softConfirmModal'));
            $('#btnKhoiPhuc').on('click', function () { softModal.show(); });

            $('#softConfirmOk').on('click', function () {
                softModal.hide();
                var form = document.getElementById('vaiTroForm');
                form.reset();
                xoaBoLoc();
                $(form).find('input[type="checkbox"]').each(function () { this.indeterminate = false; });
                $(form).find('.text-danger.field-validation-error').empty();
                $(form).find('.input-validation-error').removeClass('input-validation-error');
            });
        });
    </script>
}