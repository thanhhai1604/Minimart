@model IEnumerable<MiniMart.Web.Models.VaiTro>
@using MiniMart.Web.Helpers

@{
    ViewData["Title"] = "Danh sách vai trò nhân viên";
}

<!-- Nhúng thư viện Select2 & DataTables Bootstrap 5 -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/datatables.net-bs5@1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet" />

<style>
    #vaiTroTable tbody tr {
        cursor: pointer;
    }
    #vaiTroTable thead .filter-row th {
        cursor: default;
    }
    #vaiTroTable thead .filter-row th::before,
    #vaiTroTable thead .filter-row th::after {
        display: none !important;
    }
</style>

<div class="container-fluid px-4 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="fw-bold mb-0 text-success" style="color: #198754 !important;">
                <i class="bi bi-shield-lock-fill me-2"></i> Danh Sách Vai Trò
            </h3>
            <p class="text-success fw-bold small mb-0">
                Quản lý phân quyền và nhóm vai trò người dùng hệ thống
            </p>
        </div>
        <div class="d-flex gap-2">
            <button id="btnXoaBoLoc" class="btn btn-outline-secondary fw-semibold shadow-sm">
                <i class="bi bi-arrow-counterclockwise me-1"></i> Xóa bộ lọc
            </button>
            @if (Html.HasPermission("WEB_HT_VT_THEM"))
            {
                <a asp-action="Create" class="btn btn-success fw-bold shadow-sm">
                    <i class="bi bi-plus-lg me-1"></i> Thêm vai trò
                </a>
            }
        </div>
    </div>
    <hr />

    <div class="card border-0 shadow-sm rounded-3 overflow-hidden mb-5">
        <div class="card-body p-3">
            <div class="table-responsive">
                <table id="vaiTroTable" class="table table-hover table-bordered align-middle w-100">
                    <thead class="table-light text-secondary">
                        <tr>
                            <th class="text-center" style="width: 5%;">STT</th>
                            <th style="width: 20%;">Mã Vai Trò</th>
                            <th style="width: 30%;">Tên Vai Trò</th>
                            <th style="width: 45%;">Mô Tả</th>
                        </tr>
                        <tr class="filter-row">
                            <th class="text-center"></th>
                            <th><input type="text" class="form-control form-control-sm column-search" data-col="1" placeholder="Nhập mã vai trò..." /></th>
                            <th>
                                <select class="form-select form-select-sm select2-filter" data-col="2" style="width: 100%;">
                                    <option value="">Tất cả vai trò</option>
                                    @if (Model != null)
                                    {
                                        @foreach (var tenVaiTro in Model.Select(x => x.TenVaiTro).Distinct().Where(x => x != null))
                                        {
                                            <option value="@tenVaiTro">@tenVaiTro</option>
                                        }
                                    }
                                </select>
                            </th>
                            <th><input type="text" class="form-control form-control-sm column-search" data-col="3" placeholder="Nhập mô tả..." /></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            int chiSo = 1;
                            foreach (var item in Model)
                            {
                                <tr data-id="@item.MaVaiTro">
                                    <td class="text-center fw-semibold text-muted">@chiSo</td>
                                    <td class="fw-bold text-success">@item.MaVaiTro</td>
                                    <td class="fw-semibold text-dark">
                                        <i class="bi bi-shield-check text-primary me-2"></i> @item.TenVaiTro
                                    </td>
                                    <td class="text-muted">@(string.IsNullOrEmpty(item.MoTa) ? "—" : item.MoTa)</td>
                                </tr>
                                chiSo++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/datatables.net@1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/datatables.net-bs5@1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(document).ready(function () {
            var table = $('#vaiTroTable').DataTable({
                "language": { "url": "//cdn.jsdelivr.net/npm/datatables.net-bs5@1.13.6/i18n/vi.json" },
                "orderCellsTop": true,
                "columnDefs": [{ "orderable": false, "targets": 0 }],
                "order": [[1, 'asc']]
            });

            table.on('draw.dt', function () {
                var start = table.page.info().start;
                table.column(0, { search: 'applied', order: 'applied', page: 'current' })
                    .nodes().each(function (cell, i) {
                        cell.innerHTML = start + i + 1;
                    });
            }).draw();

            $('.select2-filter').select2({ theme: 'bootstrap-5', width: '100%', minimumResultsForSearch: 0 });

            $('.filter-row').on('click', 'input, select, .select2, .select2-selection', function (e) {
                e.stopPropagation();
            });

            $('.column-search').on('keyup change clear', function () {
                table.column($(this).data('col')).search(this.value).draw();
            });

            $('.select2-filter').on('change', function () {
                var colIndex = $(this).data('col');
                var giaTri = $(this).val();
                if (!giaTri) {
                    table.column(colIndex).search('').draw();
                } else {
                    var regex = '^\\s*' + $.fn.dataTable.util.escapeRegex(giaTri) + '\\s*$';
                    table.column(colIndex).search(regex, true, false).draw();
                }
            });

            $('#btnXoaBoLoc').on('click', function () {
                $('.column-search').val('');
                $('.select2-filter').val('').trigger('change.select2');
                table.search('').columns().search('').draw();
            });

            $('#vaiTroTable tbody').on('click', 'tr', function () {
                @if (Html.HasPermission("WEB_HT_VT_XEM"))
                {
                    <text>
                    var maVaiTro = $(this).data('id');
                    if (maVaiTro) {
                        window.location.href = '/VaiTro/Edit/' + maVaiTro;
                    }
                    </text>
                }
                else
                {
                    <text>
                    // Gọi Modal Popup số 3 định nghĩa sẵn trong Layout
                    var permissionModal = new bootstrap.Modal(document.getElementById('permissionErrorModal'));
                    permissionModal.show();
                    </text>
                }
            });
        });
    </script>
}