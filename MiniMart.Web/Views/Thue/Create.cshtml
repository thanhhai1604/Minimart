@model MiniMart.Web.Models.Thue

@{
    ViewData["Title"] = "Thêm mới mức thuế";
}

<div class="container-fluid px-4 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="fw-bold mb-0 text-success" style="color: #198754 !important;">
                Thêm Mới Mức Thuế
            </h3>
            <p class="text-success fw-bold small mb-0">
                Thêm mức thuế suất mới vào hệ thống quản lý
            </p>
        </div>

        <div class="d-flex gap-2">
            <!-- Nút xóa dữ liệu kích hoạt Popup số 5 từ Layout -->
            <button type="button" id="btnResetForm" class="btn btn-outline-secondary fw-semibold shadow-sm">
                <i class="bi bi-eraser me-1"></i> Xóa nhập liệu
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary fw-semibold shadow-sm">
                <i class="bi bi-arrow-left me-1"></i> Quay lại
            </a>
        </div>
    </div>
    <hr />

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" id="thueForm">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3" role="alert"></div>

                        <div class="row">
                            <!-- Mã Thuế -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="MaThue" class="form-label fw-semibold small text-secondary">Mã Thuế <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-success"><i class="bi bi-code-square"></i></span>
                                    <input asp-for="MaThue" class="form-control bg-light border-start-0 ps-0" placeholder="Ví dụ: VAT10..." autocomplete="off" id="MaThue" />
                                </div>
                                <span asp-validation-for="MaThue" class="text-danger small"></span>
                            </div>

                            <!-- Tên Thuế -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="TenThue" class="form-label fw-semibold small text-secondary">Tên Thuế <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-success"><i class="bi bi-receipt"></i></span>
                                    <input asp-for="TenThue" class="form-control bg-light border-start-0 ps-0" placeholder="Ví dụ: Thuế giá trị gia tăng 10%..." autocomplete="off" />
                                </div>
                                <span asp-validation-for="TenThue" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <!-- Thuế Suất -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="ThueSuat" class="form-label fw-semibold small text-secondary">Thuế Suất (Ví dụ: 0.1) <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-success"><i class="bi bi-percent"></i></span>
                                    <input asp-for="ThueSuat" type="number" step="0.01" min="0" max="1" class="form-control bg-light border-start-0 ps-0" placeholder="0.1" autocomplete="off" />
                                </div>
                                <span asp-validation-for="ThueSuat" class="text-danger small"></span>
                            </div>

                            <!-- Trạng Thái -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="TrangThai" class="form-label fw-semibold small text-secondary">Trạng Thái</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-success"><i class="bi bi-toggle-on"></i></span>
                                    <select asp-for="TrangThai" class="form-select bg-light border-start-0">
                                        <option value="1">Hoạt động</option>
                                        <option value="0">Ngừng hoạt động</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- Thanh nút chức năng -->
                        <div class="d-flex justify-content-end align-items-center border-top pt-3">
                            <button type="submit" class="btn btn-success px-4 fw-bold shadow-sm">
                                <i class="bi bi-save me-1"></i> Lưu thông tin
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {
            const clearModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('clearFormConfirmModal'));

            $('#btnResetForm').on('click', function () {
                clearModal.show();
            });

            $('#clearFormConfirmOk').on('click', function () {
                clearModal.hide();

                var $form = $('#thueForm');
                $form.find('input[type="text"], input[type="number"]').val('');
                $('#TrangThai').val('1');

                $form.find('.field-validation-error').empty();
                $form.find('.input-validation-error').removeClass('input-validation-error');
                
                $('#MaThue').trigger('focus');
            });
        });
    </script>
}