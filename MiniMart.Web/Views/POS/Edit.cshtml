@model MiniMart.Web.Models.POS
@using MiniMart.Web.Helpers

@{
    ViewData["Title"] = "Cập nhật POS";

    // Không có quyền Sửa: chỉ xem (khóa các ô, ẩn nút Lưu và Khôi phục)
    var coSua = Html.HasPermission("WEB_QL_POS_SUA");
}

<div class="container-fluid px-4 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="fw-bold mb-0 text-success" style="color: #198754 !important;">
                Cập Nhật Thiết Bị POS
            </h3>
            <p class="text-success fw-bold small mb-0">
                Chỉnh sửa thông tin thiết bị máy bán hàng hệ thống
            </p>
        </div>

        <div class="d-flex gap-2">
            @if (coSua)
            {
                <button type="button" id="btnResetEdit" class="btn btn-outline-secondary fw-semibold shadow-sm">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Khôi phục ban đầu
                </button>
            }
            <a asp-action="Index" class="btn btn-outline-secondary fw-semibold shadow-sm scalable back">
                <i class="bi bi-arrow-left me-1"></i> Quay lại
            </a>
        </div>
    </div>
    <hr />

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4">
                    <form asp-action="Edit" asp-route-id="@Model.MaPOS" asp-route-maST="@Model.MaST" method="post" id="editForm">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3" role="alert"></div>

                        <input type="hidden" asp-for="MaPOS" />
                        <input type="hidden" asp-for="MaST" />

                        <fieldset disabled="@(!coSua)">

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold small text-secondary">Mã POS</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-secondary"><i class="bi bi-code-square"></i></span>
                                    <input type="text" class="form-control bg-light border-start-0 ps-0 text-muted" value="@Model.MaPOS" disabled />
                                </div>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="TenPOS" class="form-label fw-semibold small text-secondary">Tên POS <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-success"><i class="bi bi-hdd-stack"></i></span>
                                    <input asp-for="TenPOS" class="form-control bg-light border-start-0 ps-0" placeholder="Nhập tên POS..." autocomplete="off" id="TenPOS" />
                                </div>
                                <span asp-validation-for="TenPOS" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label class="form-label fw-semibold small text-secondary">Siêu Thị Trực Thuộc</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-secondary"><i class="bi bi-shop"></i></span>
                                    <input type="text" class="form-control bg-light border-start-0 ps-0 text-muted" value="@(Model.SieuThiNavigation != null ? Model.SieuThiNavigation.TenST : Model.MaST)" disabled />
                                </div>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label asp-for="TrangThai" class="form-label fw-semibold small text-secondary">Trạng Thái Sử Dụng</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i id="iconTrangThai" class="bi fs-5"></i>
                                    </span>
                                    <select asp-for="TrangThai" class="form-select bg-light border-start-0" id="selectTrangThai">
                                        <option value="1">Đã sử dụng</option>
                                        <option value="0">Chưa sử dụng</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        </fieldset>

                        <div class="d-flex justify-content-between align-items-center border-top pt-3">
                            <div>
                                @if (Html.HasPermission("WEB_QL_POS_XOA"))
                                {
                                    <button type="button" class="btn btn-danger text-white fw-bold shadow-sm px-3" id="btnOpenDeleteModal">
                                        <i class="bi bi-trash me-1"></i> Xóa thiết bị POS
                                    </button>
                                }
                            </div>

                            <div>
                                @if (coSua)
                                {
                                    <button type="submit" class="btn btn-success px-4 fw-bold shadow-sm">
                                        <i class="bi bi-save me-1"></i> Lưu thay đổi
                                    </button>
                                }
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@if (Html.HasPermission("WEB_QL_POS_XOA"))
{
    <div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-3">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i> Xác nhận xóa thiết bị POS!</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-secondary mb-3">Bạn chắc chắn muốn xóa thiết bị POS sau khỏi hệ thống?</p>
                    <div class="bg-light p-3 rounded-3 border">
                        <ul class="list-unstyled mb-0 small">
                            <li class="mb-2">Mã POS: <span class="text-dark fw-bold">@Model.MaPOS</span></li>
                            <li class="mb-2">Tên POS: <span class="text-dark fw-bold">@Model.TenPOS</span></li>
                            <li class="mb-2">
                                Siêu thị trực thuộc: 
                                <span class="text-primary fw-bold">
                                    @(Model.SieuThiNavigation != null ? Model.SieuThiNavigation.TenST : Model.MaST)
                                </span>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0">
                    <button type="button" class="btn btn-secondary px-3 fw-bold" data-bs-dismiss="modal">Hủy bỏ</button>
                    <form asp-action="Delete" asp-route-id="@Model.MaPOS" asp-route-maST="@Model.MaST" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger text-white px-4 fw-bold shadow-sm">
                            <i class="bi bi-trash me-1"></i> Xác nhận
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        $(document).ready(function () {
            const initialValues = {
                TenPOS: $('#TenPOS').val(),
                TrangThai: $('#selectTrangThai').val()
            };

            function updateTrangThaiIcon() {
                var val = $("#selectTrangThai").val();
                var $icon = $("#iconTrangThai");
                if (val == "1") {
                    $icon.removeClass("bi-toggle-off text-danger").addClass("bi-toggle-on text-success");
                } else {
                    $icon.removeClass("bi-toggle-on text-success").addClass("bi-toggle-off text-danger");
                }
            }
            updateTrangThaiIcon();
            $("#selectTrangThai").on("change", updateTrangThaiIcon);

            const softModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('softConfirmModal'));
            
            $('#btnResetEdit').on('click', function () { 
                softModal.show(); 
            });

            $('#softConfirmOk').on('click', function () {
                softModal.hide();
                $('#TenPOS').val(initialValues.TenPOS);
                $('#selectTrangThai').val(initialValues.TrangThai).trigger('change');
            });

            const btnOpenDeleteModal = document.getElementById('btnOpenDeleteModal');
            const deleteModalElement = document.getElementById('deleteConfirmModal');
            if (btnOpenDeleteModal && deleteModalElement) {
                const deleteModal = bootstrap.Modal.getOrCreateInstance(deleteModalElement);
                btnOpenDeleteModal.addEventListener('click', function () { deleteModal.show(); });
            }
        });
    </script>
}