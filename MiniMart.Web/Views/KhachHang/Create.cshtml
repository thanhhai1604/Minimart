@model MiniMart.Web.Models.KhachHang

@{
    ViewData["Title"] = "Thêm mới khách hàng";
}

<div class="container-fluid px-4 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="fw-bold mb-0 text-success" style="color: #198754 !important;">
                Thêm Mới Khách Hàng
            </h3>
            <p class="text-success fw-bold small mb-0">
                Thêm mới thông tin hội viên khách hàng vào hệ thống
            </p>
        </div>

        <div class="d-flex gap-2">
            <button type="button" id="btnResetForm" class="btn btn-outline-secondary fw-semibold shadow-sm">
                <i class="bi bi-eraser me-1"></i> Xóa nhập liệu
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary fw-semibold shadow-sm scalable back">
                <i class="bi bi-arrow-left me-1"></i> Quay lại
            </a>
        </div>
    </div>
    <hr />

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" id="khForm">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3" role="alert"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="MaKH" class="form-label fw-semibold small text-secondary">Mã Khách Hàng <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-success"><i class="bi bi-code-square"></i></span>
                                    <input asp-for="MaKH" class="form-control bg-light border-start-0 ps-0" placeholder="Nhập mã khách hàng..." autocomplete="off" id="MaKH" />
                                </div>
                                <span asp-validation-for="MaKH" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="TenKH" class="form-label fw-semibold small text-secondary">Họ Tên Khách Hàng <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-success"><i class="bi bi-person"></i></span>
                                    <input asp-for="TenKH" class="form-control bg-light border-start-0 ps-0" placeholder="Nhập họ tên khách hàng..." autocomplete="off" />
                                </div>
                                <span asp-validation-for="TenKH" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="SoDT" class="form-label fw-semibold small text-secondary">Số Điện Thoại</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-success"><i class="bi bi-telephone"></i></span>
                                    <input asp-for="SoDT" class="form-control bg-light border-start-0 ps-0" placeholder="Nhập số điện thoại..." autocomplete="off" maxlength="11" />
                                </div>
                                <span asp-validation-for="SoDT" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label fw-semibold small text-secondary">Email</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-success"><i class="bi bi-envelope"></i></span>
                                    <input asp-for="Email" class="form-control bg-light border-start-0 ps-0" placeholder="Nhập địa chỉ email..." autocomplete="off" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12 mb-4">
                                <label asp-for="DiaChi" class="form-label fw-semibold small text-secondary">Địa Chỉ</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-success"><i class="bi bi-geo-alt"></i></span>
                                    <input asp-for="DiaChi" class="form-control bg-light border-start-0 ps-0" placeholder="Nhập địa chỉ khách hàng..." autocomplete="off" />
                                </div>
                                <span asp-validation-for="DiaChi" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end align-items-center border-top pt-3">
                            <button type="submit" class="btn btn-success px-4 fw-bold shadow-sm">
                                <i class="bi bi-save me-1"></i> Lưu thông tin
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }

    <script>
        $(document).ready(function () {
            const clearModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('clearFormConfirmModal'));

            $('#btnResetForm').on('click', function () {
                clearModal.show();
            });

            $('#clearFormConfirmOk').on('click', function () {
                clearModal.hide();
                var $form = $('#khForm');
                $form.find('input[type="text"], input[type="email"]').val('');
                $form.find('.field-validation-error').empty();
                $form.find('.input-validation-error').removeClass('input-validation-error');
                $('#MaKH').trigger('focus');
            });
        });
    </script>
}