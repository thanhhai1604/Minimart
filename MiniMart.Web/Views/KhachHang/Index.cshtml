@model IEnumerable<MiniMart.Web.Models.KhachHang>
@using MiniMart.Web.Helpers

@{
    ViewData["Title"] = "Danh sách khách hàng";
}

<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/datatables.net-bs5@1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet" />

<style>
    #khachHangTable tbody tr { cursor: pointer; }
    #khachHangTable thead .filter-row th { cursor: default; }
    #khachHangTable thead .filter-row th::before,
    #khachHangTable thead .filter-row th::after { display: none !important; }
</style>

<div class="container-fluid px-4 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="fw-bold mb-0 text-success" style="color: #198754 !important;">
                <i class="bi bi-people me-2"></i> Danh Sách Khách Hàng
            </h3>
            <p class="text-success fw-bold small mb-0">
                Quản lý thông tin hội viên và lịch sử tích điểm khách hàng
            </p>
        </div>
        <div class="d-flex gap-2">
            <button id="btnXoaBoLoc" class="btn btn-outline-secondary fw-semibold shadow-sm">
                <i class="bi bi-arrow-counterclockwise me-1"></i> Xóa bộ lọc
            </button>
            
            @if (Html.HasPermission("WEB_KH_THEM"))
            {
                <a asp-action="Create" class="btn btn-success fw-bold shadow-sm">
                    <i class="bi bi-plus-lg me-1"></i> Thêm khách hàng
                </a>
            }
        </div>
    </div>
    <hr />

    <div class="card border-0 shadow-sm rounded-3 overflow-hidden mb-5">
        <div class="card-body p-3">
            <div class="table-responsive">
                <table id="khachHangTable" class="table table-hover table-bordered align-middle w-100">
                    <thead class="table-light text-secondary">
                        <tr>
                            <th class="text-center" style="width: 5%;">STT</th>
                            <th>Mã KH</th>
                            <th>Họ Tên</th>
                            <th>Số Điện Thoại</th>
                            <th>Email</th>
                            <th>Địa Chỉ</th>
                            <th class="text-center">Điểm Tích Lũy</th>
                            <th class="text-center">Điểm Sử Dụng</th>
                            <th class="text-center">Điểm Khả Dụng</th>
                        </tr>
                        <tr class="filter-row">
                            <th class="text-center"></th>
                            <th><input type="text" class="form-control form-control-sm column-search" data-col="1" placeholder="Nhập mã KH..." /></th>
                            <th><input type="text" class="form-control form-control-sm column-search" data-col="2" placeholder="Nhập tên..." /></th>
                            <th><input type="text" class="form-control form-control-sm column-search" data-col="3" placeholder="Nhập SĐT..." /></th>
                            <th><input type="text" class="form-control form-control-sm column-search" data-col="4" placeholder="Nhập email..." /></th>
                            <th><input type="text" class="form-control form-control-sm column-search" data-col="5" placeholder="Nhập địa chỉ..." /></th>
                            <th><input type="text" class="form-control form-control-sm column-search" data-col="6" placeholder="Tìm điểm..." /></th>
                            <th><input type="text" class="form-control form-control-sm column-search" data-col="7" placeholder="Tìm điểm..." /></th>
                            <th><input type="text" class="form-control form-control-sm column-search" data-col="8" placeholder="Tìm điểm..." /></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            int chiSo = 1;
                            foreach (var item in Model)
                            {
                                <tr data-id="@item.MaKH">
                                    <td class="text-center fw-semibold text-muted">@chiSo</td>
                                    <td class="fw-bold text-success">@item.MaKH</td>
                                    <td class="fw-semibold text-dark">@item.TenKH</td>
                                    <td>@item.SoDT</td>
                                    <td class="text-muted">@item.Email</td>
                                    <td>@item.DiaChi</td>
                                    <!-- Hiển thị dạng Badge tinh tế, đồng bộ phong cách cột Vai Trò -->
                                    <td class="text-center">
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 fw-semibold">
                                            @item.DiemTichLuy.ToString("N0")
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1 fw-semibold">
                                            @item.DiemSuDung.ToString("N0")
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 fw-bold">
                                            @item.DiemKhaDung.ToString("N0")
                                        </span>
                                    </td>
                                </tr>
                                chiSo++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/datatables.net@1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/datatables.net-bs5@1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(document).ready(function () {
            var table = $('#khachHangTable').DataTable({
                "language": { "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/vi.json" },
                "orderCellsTop": true,
                "columnDefs": [{ "orderable": false, "targets": 0 }],
                "order": [[1, 'asc']]
            });

            table.on('draw.dt', function () {
                var start = table.page.info().start;
                table.column(0, { search: 'applied', order: 'applied', page: 'current' })
                    .nodes().each(function (cell, i) { cell.innerHTML = start + i + 1; });
            }).draw();

            $('.column-search').on('keyup change clear', function () {
                table.column($(this).data('col')).search(this.value).draw();
            });

            $('#btnXoaBoLoc').on('click', function () {
                $('.column-search').val('');
                table.search('').columns().search('').draw();
            });

            $('#khachHangTable tbody').on('click', 'tr', function () {
                @if (Html.HasPermission("WEB_KH_XEM"))
                {
                    <text>
                    var maKH = $(this).data('id');
                    if (maKH) { window.location.href = '/KhachHang/Edit/' + maKH; }
                    </text>
                }
                else
                {
                    <text>
                    var permissionModal = new bootstrap.Modal(document.getElementById('permissionErrorModal'));
                    permissionModal.show();
                    </text>
                }
            });
        });
    </script>
}